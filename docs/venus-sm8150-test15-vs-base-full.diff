+/*
+ * SM8150 downstream powers iris-ctl, vcodec and cvp before loading firmware.
+ * Keep those resources with the parent device, including during SESSION_INIT;
+ * the generic v4 per-session votes arrive too late for IRIS1 firmware.
+ * Runtime PM serializes this state; core_put runs after runtime PM is disabled.
+ */
+static int iris1_power_off(struct venus_core *core)
+{
+	struct device *dev = core->dev;
+	int i, ret, error = 0;
+
+	/* Never remove clocks or power while firmware still owns a domain. */
+	for (i = 2; i > 0; i--) {
+		if (!(core->iris1_hw_mask & BIT(i)))
+			continue;
+		ret = dev_pm_genpd_set_hwmode(core->pmdomains->pd_devs[i], false);
+		if (ret)
+			return ret;
+		core->iris1_hw_mask &= ~BIT(i);
+	}
+
+	if (core->iris1_clk_mask & BIT(2))
+		vcodec_clks_disable(core, core->vcodec1_clks);
+	if (core->iris1_clk_mask & BIT(1))
+		vcodec_clks_disable(core, core->vcodec0_clks);
+	if (core->iris1_clk_mask & BIT(0))
+		core_clks_disable(core);
+	core->iris1_clk_mask = 0;
+
+	for (i = 2; i >= 0; i--) {
+		if (!(core->iris1_pd_mask & BIT(i)))
+			continue;
+		ret = pm_runtime_put_sync(core->pmdomains->pd_devs[i]);
+		/* put_sync consumes our reference even when the callback fails. */
+		core->iris1_pd_mask &= ~BIT(i);
+		if (ret < 0 && !error)
+			error = ret;
+	}
+
+	if (core->iris1_opp_on) {
+		ret = dev_pm_opp_set_rate(dev, 0);
+		if (!ret)
+			core->iris1_opp_on = false;
+		else if (!error)
+			error = ret;
+	}
+
+	/* Downstream drops the video slices only after firmware is suspended. */
+	iris1_llcc_disable(core);
+
+	return error;
+}
+
+static int core_power_iris1(struct venus_core *core, int on)
+{
+	struct device *dev = core->dev;
+	unsigned long freq = core->iris1_freq;
+	struct dev_pm_opp *opp;
+	unsigned int i;
+	int ret, error;
+
+	if (on == POWER_OFF)
+		return iris1_power_off(core);
+
+	if (core->iris1_pd_mask == GENMASK(2, 0) &&
+	    core->iris1_clk_mask == GENMASK(2, 0) &&
+	    core->iris1_hw_mask == GENMASK(2, 1) && core->iris1_opp_on)
+		return iris1_llcc_enable(core);
+
+	/* A failed resume may have retained resources for safe teardown. */
+	if (core->iris1_pd_mask || core->iris1_clk_mask || core->iris1_opp_on) {
+		ret = iris1_power_off(core);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < 3; i++) {
+		ret = pm_runtime_resume_and_get(core->pmdomains->pd_devs[i]);
+		if (ret < 0)
+			goto err;
+		core->iris1_pd_mask |= BIT(i);
+
+		if (!i)
+			continue;
+		/* Use SM8150 GDSC control, never the legacy v4 wrapper offsets. */
+		ret = dev_pm_genpd_set_hwmode(core->pmdomains->pd_devs[i], false);
+		if (ret)
+			goto err;
+	}
+
+	ret = core_resets_reset(core);
+	if (ret)
+		goto err;
+
+	/* Vote MMCX as well as the RCG: the bootloader may leave it at XO. */
+	if (!freq) {
+		/* Downstream starts at the highest allowed rate before load scaling. */
+		freq = ULONG_MAX;
+		opp = dev_pm_opp_find_freq_floor(dev, &freq);
+	} else {
+		opp = dev_pm_opp_find_freq_ceil(dev, &freq);
+	}
+	if (IS_ERR(opp)) {
+		ret = PTR_ERR(opp);
+		goto err;
+	}
+	dev_pm_opp_put(opp);
+	ret = core_clks_set_rate(core, freq);
+	if (ret)
+		goto err;
+	core->iris1_opp_on = true;
+
+	ret = core_clks_enable(core);
+	if (ret)
+		goto err;
+	core->iris1_clk_mask |= BIT(0);
+	ret = vcodec_clks_enable(core, core->vcodec0_clks);
+	if (ret)
+		goto err;
+	core->iris1_clk_mask |= BIT(1);
+	ret = vcodec_clks_enable(core, core->vcodec1_clks);
+	if (ret)
+		goto err;
+	core->iris1_clk_mask |= BIT(2);
+
+	/* Like downstream, hand off MVS0/MVS1 only after all clocks are on. */
+	for (i = 1; i < 3; i++) {
+		ret = dev_pm_genpd_set_hwmode(core->pmdomains->pd_devs[i], true);
+		if (ret)
+			goto err;
+		core->iris1_hw_mask |= BIT(i);
+	}
+
+	ret = iris1_llcc_enable(core);
+	if (ret)
+		goto err;
+
+	dev_info_once(dev, "venus-test7: IRIS1 resources ready at %lu Hz (MVSC, MVS0, CVP)\n",
+		      clk_get_rate(core->clks[0]));
+	return 0;
+
+err:
+	error = iris1_power_off(core);
+	if (error)
+		dev_err(dev, "IRIS1 power-on rollback failed: %d\n", error);
+	return ret;
+}
+
+static void core_put_iris1(struct venus_core *core)
+{
+	int ret;
+
+	/* Also release a failed probe/resume, which cannot call runtime_suspend. */
+	ret = iris1_power_off(core);
+	if (ret)
+		dev_err(core->dev, "IRIS1 resource release failed: %d\n", ret);
+
+	iris1_llcc_put(core);
+}
