+int venus_helper_cache_bufreqs(struct venus_inst *inst)
+{
+	const u32 ptype = HFI_PROPERTY_CONFIG_BUFFER_REQUIREMENTS;
+	enum hfi_version ver = inst->core->res->hfi_version;
+	union hfi_get_property hprop;
+	bool have_input = false, have_output = false;
+	unsigned long seen = 0;
+	unsigned int i;
+	int ret;
+
+	/* This cache is intentionally limited to the audited VPU5 encoder. */
+	if (!IS_IRIS1(inst->core) ||
+	    inst->session_type != VIDC_SESSION_TYPE_ENC)
+		return -EINVAL;
+	if (inst->num_input_bufs < VENUS_IRIS1_ENC_MIN_BUFFERS ||
+	    inst->num_input_bufs > VIDEO_MAX_FRAME ||
+	    inst->num_output_bufs < VENUS_IRIS1_ENC_MIN_BUFFERS ||
+	    inst->num_output_bufs > VIDEO_MAX_FRAME)
+		return -EINVAL;
+
+	inst->bufreq_cache_valid = false;
+	ret = hfi_session_get_property(inst, ptype, &hprop);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < HFI_BUFFER_TYPE_MAX; i++) {
+		struct hfi_buffer_requirements *req = &hprop.bufreq[i];
+		u32 count_actual, count_min, count_min_host;
+
+		if (!req->type)
+			continue;
+
+		count_actual = req->count_actual;
+		count_min = hfi_bufreq_get_count_min(req, ver);
+		count_min_host = hfi_bufreq_get_count_min_host(req, ver);
+		if (req->type > HFI_BUFFER_EXTRADATA_INPUT(HFI_VERSION_4XX) ||
+		    (seen & BIT(req->type)) ||
+		    count_actual > VIDEO_MAX_FRAME ||
+		    count_min > VIDEO_MAX_FRAME ||
+		    count_min_host > VIDEO_MAX_FRAME ||
+		    (count_actual && count_min && count_actual < count_min) ||
+		    (req->alignment && !is_power_of_2(req->alignment))) {
+			dev_err(inst->core->dev,
+				"venus-test10: invalid encoder bufreq type=%#x actual=%u min=%u host=%u align=%u\n",
+				req->type, count_actual, count_min,
+				count_min_host, req->alignment);
+			return -EINVAL;
+		}
+		seen |= BIT(req->type);
+
+		if (req->type == HFI_BUFFER_INPUT) {
+			if (!req->size)
+				return -EINVAL;
+			have_input = true;
+		} else if (req->type == HFI_BUFFER_OUTPUT) {
+			if (!req->size)
+				return -EINVAL;
+			have_output = true;
+		}
+
+		dev_info(inst->core->dev,
+			 "venus-test10: firmware bufreq type=%#x size=%u actual=%u min=%u host=%u align=%u\n",
+			 req->type, req->size, count_actual,
+			 count_min, count_min_host, req->alignment);
+	}
+	if (!have_input || !have_output)
+		return -EINVAL;
+
+	memcpy(inst->bufreq_cache, hprop.bufreq,
+	       sizeof(inst->bufreq_cache));
+	inst->bufreq_cache_valid = true;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(venus_helper_cache_bufreqs);
