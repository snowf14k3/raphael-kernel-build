+static int venc_iris1_preflight(struct venus_inst *inst)
+{
+	struct venus_core *core = inst->core;
+
+	if (!IS_IRIS1(core))
+		return 0;
+	if (!READ_ONCE(venus_iris1_encoder_enable)) {
+		dev_warn_ratelimited(core->dev,
+				     "venus-test10: SM8150 encoder is safety-locked\n");
+		return -EOPNOTSUPP;
+	}
+
+	/*
+	 * Do not start VPU5 DMA unless every resource from the downstream power
+	 * sequence is still owned.  Failing STREAMON is recoverable; allowing a
+	 * partially powered encoder to reach LOAD_RESOURCES is not.
+	 */
+	if (core->iris1_pd_mask != GENMASK(2, 0) ||
+	    core->iris1_clk_mask != GENMASK(2, 0) ||
+	    core->iris1_hw_mask != GENMASK(2, 1) ||
+	    core->iris1_llcc_mask != GENMASK(VIDC_IRIS1_LLCC_NUM - 1, 0) ||
+	    !core->iris1_opp_on || !inst->core_acquired) {
+		dev_err(core->dev,
+			"venus-test10: refusing encoder start: pd=%#x clk=%#x hw=%#x llcc=%#x opp=%u core=%u\n",
+			core->iris1_pd_mask, core->iris1_clk_mask,
+			core->iris1_hw_mask, core->iris1_llcc_mask,
+			core->iris1_opp_on, inst->core_acquired);
+		return -EIO;
+	}
+
+	if (!inst->fmt_out || inst->fmt_out->pixfmt != V4L2_PIX_FMT_NV12 ||
+	    !inst->input_buf_size || !inst->output_buf_size || !inst->fps) {
+		dev_err(core->dev,
+			"venus-test10: refusing invalid encoder configuration\n");
+		return -EINVAL;
+	}
+
+	return 0;
