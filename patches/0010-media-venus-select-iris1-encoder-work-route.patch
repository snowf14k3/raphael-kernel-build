From 4179f78ab5bc9909c4a5e5cc04f627b700a5903e Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Fri, 11 Sep 2026 22:53:15 +0800
Subject: [PATCH] media: venus: select the IRIS1 encoder work route

Send the VPU5 work route before querying or allocating session buffers,
and again when final controls are applied at STREAMON. Use two pipes
for ordinary H.264/HEVC, one for VP8, byte-limited slices and CBR up to
720p30. Constant-quality mode keeps both pipes except for VP8.

Reference: Android Q msm_vidc_clocks.c msm_vidc_decide_work_route(),
lines 1228-1288; msm_vidc_common.h CBR_MB_LIMIT/CBR_VFR_MB_LIMIT,
downstream 192eca8550f95c.

Only the IRIS1 encoder path is affected. No frequency scaling or decoder
behavior is changed. Validate route selection for VBR, CBR, CQ and
slice limits, then validate a real NV12-to-H.264 stream on hardware.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 drivers/media/platform/qcom/venus/venc.c | 27 ++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index bf53267cb..51f7e8928 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -659,6 +659,29 @@ static void venc_pm_touch(struct venus_inst *inst)
 	pm_runtime_mark_last_busy(inst->core->dev_enc);
 }
 
+static int venc_set_work_route(struct venus_inst *inst)
+{
+	struct venc_controls *ctr = &inst->controls.enc;
+	struct hfi_video_work_route wr;
+	u64 mbs_per_sec;
+
+	if (!IS_IRIS1(inst->core))
+		return 0;
+
+	wr.video_work_route = inst->core->res->num_vpp_pipes;
+	mbs_per_sec = (u64)DIV_ROUND_UP(inst->width, 16) *
+		     DIV_ROUND_UP(inst->height, 16) * inst->fps;
+
+	if (inst->hfi_codec == HFI_VIDEO_CODEC_VP8 ||
+	    (ctr->bitrate_mode != V4L2_MPEG_VIDEO_BITRATE_MODE_CQ &&
+	     (ctr->multi_slice_mode == V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_MAX_BYTES ||
+	      (ctr->bitrate_mode == V4L2_MPEG_VIDEO_BITRATE_MODE_CBR &&
+	       mbs_per_sec <= 108000))))
+		wr.video_work_route = 1;
+
+	return hfi_session_set_property(inst, HFI_PROPERTY_PARAM_WORK_ROUTE, &wr);
+}
+
 static int venc_set_properties(struct venus_inst *inst)
 {
 	struct venc_controls *ctr = &inst->controls.enc;
@@ -680,6 +703,10 @@ static int venc_set_properties(struct venus_inst *inst)
 	if (ret)
 		return ret;
 
+	ret = venc_set_work_route(inst);
+	if (ret)
+		return ret;
+
 	ptype = HFI_PROPERTY_CONFIG_FRAME_RATE;
 	frate.buffer_type = HFI_BUFFER_OUTPUT;
 	frate.framerate = inst->fps * (1 << 16);
-- 
