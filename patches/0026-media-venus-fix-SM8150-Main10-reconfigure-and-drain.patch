From ee79619554a679be4f9bf2f7fd0a134353ee8f1f Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Wed, 9 Sep 2026 18:43:52 +0800
Subject: [PATCH] media: venus: fix SM8150 Main10 reconfigure and drain

Align the legacy HFI4 decoder with the SM8150 firmware contract for
Main10 geometry, color metadata, dynamic reconfiguration, flush
accounting and synthetic drain handling.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 drivers/media/platform/qcom/venus/core.h     |   6 +
 drivers/media/platform/qcom/venus/hfi.c      |  38 ++++++-
 drivers/media/platform/qcom/venus/hfi.h      |   2 +
 drivers/media/platform/qcom/venus/hfi_msgs.c |  18 ++-
 drivers/media/platform/qcom/venus/vdec.c     | 112 ++++++++++++++++++-
 drivers/media/platform/qcom/venus/venc.c     |   6 +-
 6 files changed, 171 insertions(+), 11 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/core.h b/drivers/media/platform/qcom/venus/core.h
index 39a0523535d1..186eaea12efe 100644
--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -492,6 +492,9 @@ enum venus_inst_modes {
  * @done:	a completion for sync HFI operation
  * @error:	an error returned during last HFI sync operation
  * @session_error:	a flag rised by HFI interface in case of session error
+ * @flush_done:	completion for one or more outstanding flush responses
+ * @flush_pending:	number of flush responses still expected from firmware
+ * @flush_error:	first error returned by an outstanding flush batch
  * @ops:		HFI operations
  * @session_type:	the type of the session (decoder or encoder)
  * @hprop:	a union used as a holder by get property
@@ -578,6 +581,9 @@ struct venus_inst {
 	struct completion done;
 	unsigned int error;
 	bool session_error;
+	struct completion flush_done;
+	atomic_t flush_pending;
+	u32 flush_error;
 	const struct hfi_inst_ops *ops;
 	u32 session_type;
 	union hfi_get_property hprop;
diff --git a/drivers/media/platform/qcom/venus/hfi.c b/drivers/media/platform/qcom/venus/hfi.c
index aa1c8d271607..72ac4b4c29b2 100644
--- a/drivers/media/platform/qcom/venus/hfi.c
+++ b/drivers/media/platform/qcom/venus/hfi.c
@@ -125,6 +125,22 @@ static int wait_session_msg(struct venus_inst *inst)
 	return 0;
 }
 
+static int wait_session_flush(struct venus_inst *inst)
+{
+	int ret;
+
+	ret = wait_for_completion_timeout(&inst->flush_done, TIMEOUT);
+	if (!ret) {
+		venus_hfi_dump_state(inst->core, "session flush response", -ETIMEDOUT);
+		return -ETIMEDOUT;
+	}
+
+	if (READ_ONCE(inst->flush_error) != HFI_ERR_NONE)
+		return -EIO;
+
+	return 0;
+}
+
 int hfi_session_create(struct venus_inst *inst, const struct hfi_inst_ops *ops)
 {
 	struct venus_core *core = inst->core;
@@ -136,6 +152,9 @@ int hfi_session_create(struct venus_inst *inst, const struct hfi_inst_ops *ops)
 
 	inst->state = INST_UNINIT;
 	init_completion(&inst->done);
+	init_completion(&inst->flush_done);
+	atomic_set(&inst->flush_pending, 0);
+	inst->flush_error = HFI_ERR_NONE;
 	inst->ops = ops;
 
 	mutex_lock(&core->lock);
@@ -402,19 +421,32 @@ EXPORT_SYMBOL_GPL(hfi_session_unload_res);
 int hfi_session_flush(struct venus_inst *inst, u32 type, bool block)
 {
 	const struct hfi_ops *ops = inst->core->ops;
+	int pending;
 	int ret;
 
 	if (test_bit(0, &inst->core->sys_error))
 		return -EIO;
 
-	reinit_completion(&inst->done);
+	/*
+	 * A sequence-change flush is asynchronous. If streamoff queues a
+	 * blocking flush before that response arrives, a shared completion can
+	 * mistake the first response for the second command. Count all queued
+	 * flushes and use a dedicated completion, as the newer Iris driver does.
+	 */
+	pending = atomic_inc_return(&inst->flush_pending);
+	if (pending == 1)
+		WRITE_ONCE(inst->flush_error, HFI_ERR_NONE);
+	if (block)
+		reinit_completion(&inst->flush_done);
 
 	ret = ops->session_flush(inst, type);
-	if (ret)
+	if (ret) {
+		atomic_dec(&inst->flush_pending);
 		return ret;
+	}
 
 	if (block) {
-		ret = wait_session_msg(inst);
+		ret = wait_session_flush(inst);
 		if (ret)
 			return ret;
 	}
diff --git a/drivers/media/platform/qcom/venus/hfi.h b/drivers/media/platform/qcom/venus/hfi.h
index 0338841d5992..5379d48cb0ed 100644
--- a/drivers/media/platform/qcom/venus/hfi.h
+++ b/drivers/media/platform/qcom/venus/hfi.h
@@ -18,6 +18,8 @@
 #define VIDC_RESOURCE_OCMEM			1
 #define VIDC_RESOURCE_VMEM			2
 
+#define HFI_DUMMY_EOS_BUFFER_ADDR		0xdeadb000
+
 struct hfi_buffer_desc {
 	u32 buffer_type;
 	u32 buffer_size;
diff --git a/drivers/media/platform/qcom/venus/hfi_msgs.c b/drivers/media/platform/qcom/venus/hfi_msgs.c
index 420d3eae9caf..437a6a75db2b 100644
--- a/drivers/media/platform/qcom/venus/hfi_msgs.c
+++ b/drivers/media/platform/qcom/venus/hfi_msgs.c
@@ -535,9 +535,19 @@ static void hfi_session_flush_done(struct venus_core *core,
 				   struct venus_inst *inst, void *packet)
 {
 	struct hfi_msg_session_flush_done_pkt *pkt = packet;
+	int pending;
 
-	inst->error = pkt->error_type;
-	complete(&inst->done);
+	if (pkt->error_type != HFI_ERR_NONE)
+		WRITE_ONCE(inst->flush_error, pkt->error_type);
+
+	if (WARN_ON_ONCE(atomic_read(&inst->flush_pending) <= 0))
+		goto notify;
+
+	pending = atomic_dec_return(&inst->flush_pending);
+	if (!pending)
+		complete(&inst->flush_done);
+
+notify:
 	if (inst->ops->flush_done)
 		inst->ops->flush_done(inst);
 }
@@ -549,6 +559,10 @@ static void hfi_session_etb_done(struct venus_core *core,
 	u32 hfi_flags = 0;
 	u32 ebd_count = 0;
 
+	/* Drain uses a synthetic ETB which has no matching V4L2 buffer. */
+	if (pkt->packet_buffer == HFI_DUMMY_EOS_BUFFER_ADDR)
+		return;
+
 	if (IS_IRIS1(core))
 		ebd_count = READ_ONCE(inst->iris1_ebd_count) + 1;
 
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 6fe3b3144911..e26174f34d0a 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2012-2016, The Linux Foundation. All rights reserved.
  * Copyright (C) 2017 Linaro Ltd.
  */
+#include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/module.h>
 #include <linux/mod_devicetable.h>
@@ -125,6 +126,91 @@ static bool vdec_fmt_is_10bit(u32 pixfmt)
 	       pixfmt == V4L2_PIX_FMT_QC10C;
 }
 
+static u32 vdec_hfi_color_primaries(u32 primaries)
+{
+	switch (primaries) {
+	case 1:
+		return V4L2_COLORSPACE_REC709;
+	case 4:
+		return V4L2_COLORSPACE_470_SYSTEM_M;
+	case 5:
+		return V4L2_COLORSPACE_470_SYSTEM_BG;
+	case 6:
+		return V4L2_COLORSPACE_SMPTE170M;
+	case 7:
+		return V4L2_COLORSPACE_SMPTE240M;
+	case 9:
+		return V4L2_COLORSPACE_BT2020;
+	case 11:
+		return V4L2_COLORSPACE_DCI_P3;
+	default:
+		return V4L2_COLORSPACE_DEFAULT;
+	}
+}
+
+static u8 vdec_hfi_transfer_char(u32 transfer)
+{
+	switch (transfer) {
+	case 1:
+		return V4L2_XFER_FUNC_709;
+	case 7:
+		return V4L2_XFER_FUNC_SMPTE240M;
+	case 13:
+		return V4L2_XFER_FUNC_SRGB;
+	case 16:
+		return V4L2_XFER_FUNC_SMPTE2084;
+	default:
+		return V4L2_XFER_FUNC_DEFAULT;
+	}
+}
+
+static u8 vdec_hfi_matrix_coefficients(u32 matrix)
+{
+	switch (matrix) {
+	case 1:
+		return V4L2_YCBCR_ENC_709;
+	case 5:
+		return V4L2_YCBCR_ENC_XV601;
+	case 6:
+		return V4L2_YCBCR_ENC_601;
+	case 7:
+		return V4L2_YCBCR_ENC_SMPTE240M;
+	case 9:
+		return V4L2_YCBCR_ENC_BT2020;
+	case 10:
+		return V4L2_YCBCR_ENC_BT2020_CONST_LUM;
+	default:
+		return V4L2_YCBCR_ENC_DEFAULT;
+	}
+}
+
+static void vdec_update_colorimetry(struct venus_inst *inst, u32 colour_space)
+{
+	u32 primaries, transfer, matrix;
+
+	inst->colorspace = V4L2_COLORSPACE_DEFAULT;
+	inst->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+	inst->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	inst->quantization = V4L2_QUANTIZATION_DEFAULT;
+
+	if (!FIELD_GET(BIT(29), colour_space))
+		return;
+
+	inst->quantization = FIELD_GET(BIT(25), colour_space) ?
+		V4L2_QUANTIZATION_FULL_RANGE : V4L2_QUANTIZATION_LIM_RANGE;
+
+	if (!FIELD_GET(BIT(24), colour_space))
+		return;
+
+	primaries = FIELD_GET(GENMASK(23, 16), colour_space);
+	transfer = FIELD_GET(GENMASK(15, 8), colour_space);
+	matrix = FIELD_GET(GENMASK(7, 0), colour_space);
+
+	inst->colorspace = vdec_hfi_color_primaries(primaries);
+	inst->xfer_func = vdec_hfi_transfer_char(transfer);
+	inst->ycbcr_enc = vdec_hfi_matrix_coefficients(matrix);
+}
+
 static bool vdec_capture_fmt_matches_stream(struct venus_inst *inst,
 					    u32 pixfmt)
 {
@@ -272,10 +358,15 @@ vdec_try_fmt_common(struct venus_inst *inst, struct v4l2_format *f)
 			      frame_height_max(inst));
 
 	if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
-		if (pixmp->pixelformat == V4L2_PIX_FMT_QC10C)
+		if (pixmp->pixelformat == V4L2_PIX_FMT_P010) {
+			pixmp->width = ALIGN(pixmp->width, 128);
+			pixmp->height = ALIGN(pixmp->height, 32);
+		} else if (pixmp->pixelformat == V4L2_PIX_FMT_QC10C) {
+			pixmp->width = roundup(pixmp->width, 192);
 			pixmp->height = ALIGN(pixmp->height, 16);
-		else
+		} else {
 			pixmp->height = ALIGN(pixmp->height, 32);
+		}
 	}
 
 	if (pixmp->field == V4L2_FIELD_ANY)
@@ -685,7 +776,7 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 		if (IS_IRIS2(inst->core) && is_fw_rev_or_older(inst->core, 1, 0, 87))
 			fdata.device_addr = 0;
 		else
-			fdata.device_addr = 0xdeadb000;
+			fdata.device_addr = HFI_DUMMY_EOS_BUFFER_ADDR;
 
 		ret = hfi_session_process_buf(inst, &fdata);
 
@@ -1621,9 +1712,23 @@ static void vdec_buf_done(struct venus_inst *inst, unsigned int buf_type,
 		vb->timestamp = timestamp_us * NSEC_PER_USEC;
 		vbuf->sequence = inst->sequence_cap++;
 
+		/*
+		 * Sequence-change flushes can return an empty capture buffer
+		 * without the HFI EOS bit. Mark the first such buffer LAST so
+		 * userspace can finish the old sequence without queueing an extra
+		 * capture buffer solely to receive the marker.
+		 */
+		if (!bytesused && inst->next_buf_last &&
+		    inst->codec_state == VENUS_DEC_STATE_DRC) {
+			vbuf->flags |= V4L2_BUF_FLAG_LAST;
+			inst->next_buf_last = false;
+		}
+
 		if (vbuf->flags & V4L2_BUF_FLAG_LAST) {
 			const struct v4l2_event ev = { .type = V4L2_EVENT_EOS };
 
+			/* Firmware supplied LAST; suppress the queued-buffer fallback. */
+			inst->next_buf_last = false;
 			v4l2_event_queue_fh(&inst->fh, &ev);
 
 			if (inst->codec_state == VENUS_DEC_STATE_DRAIN) {
@@ -1665,6 +1770,7 @@ static void vdec_event_change(struct venus_inst *inst,
 	struct v4l2_format format = {};
 
 	mutex_lock(&inst->lock);
+	vdec_update_colorimetry(inst, ev_data->colour_space);
 
 	if (inst->bit_depth != ev_data->bit_depth) {
 		inst->bit_depth = ev_data->bit_depth;
diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index 89ec1ea48c65..e4bcf3632ae6 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -686,11 +686,11 @@ venc_encoder_cmd(struct file *file, void *fh, struct v4l2_encoder_cmd *cmd)
 
 		fdata.buffer_type = HFI_BUFFER_INPUT;
 		fdata.flags |= HFI_BUFFERFLAG_EOS;
-		fdata.device_addr = 0xdeadb000;
+		fdata.device_addr = HFI_DUMMY_EOS_BUFFER_ADDR;
 
 		ret = hfi_session_process_buf(inst, &fdata);
-
-		inst->enc_state = VENUS_ENC_STATE_DRAIN;
+		if (!ret)
+			inst->enc_state = VENUS_ENC_STATE_DRAIN;
 	} else if (cmd->cmd == V4L2_ENC_CMD_START) {
 		if (inst->enc_state == VENUS_ENC_STATE_DRAIN) {
 			ret = -EBUSY;
-- 
