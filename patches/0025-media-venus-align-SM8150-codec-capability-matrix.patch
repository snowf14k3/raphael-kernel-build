+++ b/drivers/media/platform/qcom/venus/vdec_ctrls.c
@@ -98,8 +98,39 @@ static const struct v4l2_ctrl_ops vdec_ctrl_ops = {
 int vdec_ctrl_init(struct venus_inst *inst)
 {
 	struct v4l2_ctrl *ctrl;
+	u64 h264_profiles, hevc_profiles, vp8_profiles, vp9_profiles;
+	u32 h264_profile_max, hevc_profile_max;
+	u32 vp8_profile_max, vp9_profile_max;
+	u32 h264_level_max = V4L2_MPEG_VIDEO_H264_LEVEL_5_1;
+	u32 vp9_level_max = V4L2_MPEG_VIDEO_VP9_LEVEL_6_1;
+	u32 domain = VIDC_SESSION_TYPE_DEC;
 	int ret;
 
+	h264_profiles = venus_helper_get_profile_mask(inst->core, HFI_VIDEO_CODEC_H264, domain);
+	hevc_profiles = venus_helper_get_profile_mask(inst->core, HFI_VIDEO_CODEC_HEVC, domain);
+	vp8_profiles = venus_helper_get_profile_mask(inst->core, HFI_VIDEO_CODEC_VP8, domain);
+	vp9_profiles = venus_helper_get_profile_mask(inst->core, HFI_VIDEO_CODEC_VP9, domain);
+	if (!h264_profiles)
+		h264_profiles = BIT_ULL(V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE) |
+				BIT_ULL(V4L2_MPEG_VIDEO_H264_PROFILE_MAIN) |
+				BIT_ULL(V4L2_MPEG_VIDEO_H264_PROFILE_HIGH);
+	if (!hevc_profiles)
+		hevc_profiles = BIT_ULL(V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN) |
+				BIT_ULL(V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10);
+	if (!vp8_profiles)
+		vp8_profiles = GENMASK_ULL(V4L2_MPEG_VIDEO_VP8_PROFILE_3, 0);
+	if (!vp9_profiles)
+		vp9_profiles = BIT_ULL(V4L2_MPEG_VIDEO_VP9_PROFILE_0);
+
+	h264_profile_max = fls64(h264_profiles) - 1;
+	hevc_profile_max = fls64(hevc_profiles) - 1;
+	vp8_profile_max = fls64(vp8_profiles) - 1;
+	vp9_profile_max = fls64(vp9_profiles) - 1;
+	venus_helper_get_max_level(inst->core, HFI_VIDEO_CODEC_H264,
+				   domain, &h264_level_max);
+	venus_helper_get_max_level(inst->core, HFI_VIDEO_CODEC_VP9,
+				   domain, &vp9_level_max);
+
 	ret = v4l2_ctrl_handler_init(&inst->ctrl_handler, 13);
 	if (ret)
 		return ret;
@@ -115,9 +146,8 @@ int vdec_ctrl_init(struct venus_inst *inst)
 
 	ctrl = v4l2_ctrl_new_std_menu(&inst->ctrl_handler, &vdec_ctrl_ops,
 				      V4L2_CID_MPEG_VIDEO_HEVC_PROFILE,
-				      V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10,
-				      ~((1 << V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN) |
-					(1 << V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10)),
