 	.fmts[0] = {HFI_BUFFER_OUTPUT, HFI_COLOR_FORMAT_NV12_UBWC},
 	.fmts[1] = {HFI_BUFFER_OUTPUT, HFI_COLOR_FORMAT_YUV420_TP10_UBWC},
@@ -299,8 +299,8 @@ static const struct hfi_plat_caps caps_lite[] = {
 	.caps[5] = {HFI_CAPABILITY_FRAMERATE, 1, 120, 1},
 	.caps[6] = {HFI_CAPABILITY_MAX_VIDEOCORES, 0, 1, 1},
 	.num_caps = 7,
-	.pl[0] = {HFI_VP9_PROFILE_P0, 200},
-	.pl[1] = {HFI_VP9_PROFILE_P2_10B, 200},
+	.pl[0] = {HFI_VP9_PROFILE_P0, HFI_VP9_LEVEL_61},
+	.pl[1] = {HFI_VP9_PROFILE_P2_10B, HFI_VP9_LEVEL_61},
 	.num_pl = 2,
 	.fmts[0] = {HFI_BUFFER_OUTPUT, HFI_COLOR_FORMAT_NV12_UBWC},
 	.fmts[1] = {HFI_BUFFER_OUTPUT2, HFI_COLOR_FORMAT_NV12_UBWC},
diff --git a/drivers/media/platform/qcom/venus/vdec_ctrls.c b/drivers/media/platform/qcom/venus/vdec_ctrls.c
index 3c4e12b9c81f..a037c248e3fd 100644
