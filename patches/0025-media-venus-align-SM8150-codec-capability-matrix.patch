 		V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE);
 	if (ctrl)
 		ctrl->flags |= V4L2_CTRL_FLAG_VOLATILE;
 
 	ctrl = v4l2_ctrl_new_std_menu(&inst->ctrl_handler, &vdec_ctrl_ops,
 				      V4L2_CID_MPEG_VIDEO_H264_LEVEL,
-				      V4L2_MPEG_VIDEO_H264_LEVEL_5_1,
