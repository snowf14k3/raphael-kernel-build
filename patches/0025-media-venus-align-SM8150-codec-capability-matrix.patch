From be2d498d0d964df63e7c96db3b7e0641455c0bd4 Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Wed, 9 Sep 2026 17:52:39 +0800
Subject: [PATCH] media: venus: align SM8150 codec capability matrix

Derive profile and level controls from the HFI capability table.
Correct H.264 5.2, VP9 6.1, and VPU5 VP8 wire mappings.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 drivers/media/platform/qcom/venus/helpers.c   | 155 +++++++++++++++++-
 drivers/media/platform/qcom/venus/helpers.h   |   4 +
 .../platform/qcom/venus/hfi_platform_v4.c     |   8 +-
 .../media/platform/qcom/venus/vdec_ctrls.c    |  56 +++++--
 .../media/platform/qcom/venus/venc_ctrls.c    |  47 ++++--
 5 files changed, 231 insertions(+), 39 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
index cb0307e16336..1fd7a9d160f7 100644
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -997,7 +997,7 @@ static const struct id_mapping h264_levels[] = {
 	{ HFI_H264_LEVEL_42, V4L2_MPEG_VIDEO_H264_LEVEL_4_2 },
 	{ HFI_H264_LEVEL_5, V4L2_MPEG_VIDEO_H264_LEVEL_5_0 },
 	{ HFI_H264_LEVEL_51, V4L2_MPEG_VIDEO_H264_LEVEL_5_1 },
-	{ HFI_H264_LEVEL_52, V4L2_MPEG_VIDEO_H264_LEVEL_5_1 },
+	{ HFI_H264_LEVEL_52, V4L2_MPEG_VIDEO_H264_LEVEL_5_2 },
 };
 
 static const struct id_mapping hevc_profiles[] = {
@@ -1029,6 +1029,13 @@ static const struct id_mapping vp8_profiles[] = {
 	{ HFI_VPX_PROFILE_VERSION_3, V4L2_MPEG_VIDEO_VP8_PROFILE_3 },
 };
 
+static const struct id_mapping vp8_levels[] = {
+	{ HFI_VPX_LEVEL_VERSION_0, V4L2_MPEG_VIDEO_VP8_PROFILE_0 },
+	{ HFI_VPX_LEVEL_VERSION_1, V4L2_MPEG_VIDEO_VP8_PROFILE_1 },
+	{ HFI_VPX_LEVEL_VERSION_2, V4L2_MPEG_VIDEO_VP8_PROFILE_2 },
+	{ HFI_VPX_LEVEL_VERSION_3, V4L2_MPEG_VIDEO_VP8_PROFILE_3 },
+};
+
 static const struct id_mapping vp9_profiles[] = {
 	{ HFI_VP9_PROFILE_P0, V4L2_MPEG_VIDEO_VP9_PROFILE_0 },
 	{ HFI_VP9_PROFILE_P2_10B, V4L2_MPEG_VIDEO_VP9_PROFILE_2 },
@@ -1077,8 +1084,26 @@ static u32 find_hfi_id(u32 v4l2_id, const struct id_mapping *array, unsigned int
 	return 0;
 }
 
+static bool find_v4l2_id_checked(u32 hfi_id, const struct id_mapping *array,
+				 unsigned int array_sz, u32 *v4l2_id)
+{
+	unsigned int i;
+
+	for (i = 0; i < array_sz; i++) {
+		if (hfi_id != array[i].hfi_id)
+			continue;
+
+		*v4l2_id = array[i].v4l2_id;
+		return true;
+	}
+
+	return false;
+}
+
 static void
-v4l2_id_profile_level(u32 hfi_codec, struct hfi_profile_level *pl, u32 *profile, u32 *level)
+v4l2_id_profile_level(u32 hfi_codec, bool iris1,
+		      struct hfi_profile_level *pl, u32 *profile,
+		      u32 *level)
 {
 	u32 hfi_pf = pl->profile;
 	u32 hfi_lvl = pl->level;
@@ -1097,7 +1122,13 @@ v4l2_id_profile_level(u32 hfi_codec, struct hfi_profile_level *pl, u32 *profile,
 		*level = find_v4l2_id(hfi_lvl, mpeg4_levels, ARRAY_SIZE(mpeg4_levels));
 		break;
 	case HFI_VIDEO_CODEC_VP8:
-		*profile = find_v4l2_id(hfi_pf, vp8_profiles, ARRAY_SIZE(vp8_profiles));
+		/* VPU5 reports VP8 MAIN in profile and the version in level. */
+		if (iris1)
+			*profile = find_v4l2_id(hfi_lvl, vp8_levels,
+						ARRAY_SIZE(vp8_levels));
+		else
+			*profile = find_v4l2_id(hfi_pf, vp8_profiles,
+						ARRAY_SIZE(vp8_profiles));
 		*level = 0;
 		break;
 	case HFI_VIDEO_CODEC_VP9:
@@ -1113,6 +1144,116 @@ v4l2_id_profile_level(u32 hfi_codec, struct hfi_profile_level *pl, u32 *profile,
 	}
 }
 
+static bool hfi_profile_to_v4l2(u32 hfi_codec, bool iris1,
+				const struct hfi_profile_level *pl,
+				u32 *profile)
+{
+	switch (hfi_codec) {
+	case HFI_VIDEO_CODEC_H264:
+		return find_v4l2_id_checked(pl->profile, h264_profiles,
+					    ARRAY_SIZE(h264_profiles), profile);
+	case HFI_VIDEO_CODEC_MPEG2:
+		return find_v4l2_id_checked(pl->profile, mpeg2_profiles,
+					    ARRAY_SIZE(mpeg2_profiles), profile);
+	case HFI_VIDEO_CODEC_MPEG4:
+		return find_v4l2_id_checked(pl->profile, mpeg4_profiles,
+					    ARRAY_SIZE(mpeg4_profiles), profile);
+	case HFI_VIDEO_CODEC_VP8:
+		if (iris1)
+			return find_v4l2_id_checked(pl->level, vp8_levels,
+						    ARRAY_SIZE(vp8_levels),
+						    profile);
+		return find_v4l2_id_checked(pl->profile, vp8_profiles,
+					    ARRAY_SIZE(vp8_profiles), profile);
+	case HFI_VIDEO_CODEC_VP9:
+		return find_v4l2_id_checked(pl->profile, vp9_profiles,
+					    ARRAY_SIZE(vp9_profiles), profile);
+	case HFI_VIDEO_CODEC_HEVC:
+		return find_v4l2_id_checked(pl->profile, hevc_profiles,
+					    ARRAY_SIZE(hevc_profiles), profile);
+	default:
+		return false;
+	}
+}
+
+u64 venus_helper_get_profile_mask(struct venus_core *core, u32 hfi_codec,
+				  u32 domain)
+{
+	struct hfi_plat_caps *caps;
+	u64 mask = 0;
+	unsigned int i;
+	u32 profile;
+
+	caps = venus_caps_by_codec(core, hfi_codec, domain);
+	if (!caps)
+		return 0;
+
+	for (i = 0; i < caps->num_pl; i++) {
+		if (hfi_profile_to_v4l2(hfi_codec, IS_IRIS1(core),
+					&caps->pl[i], &profile) && profile < 64)
+			mask |= BIT_ULL(profile);
+	}
+
+	return mask;
+}
+EXPORT_SYMBOL_GPL(venus_helper_get_profile_mask);
+
+int venus_helper_get_max_level(struct venus_core *core, u32 hfi_codec,
+			       u32 domain, u32 *max_level)
+{
+	const struct id_mapping *levels;
+	struct hfi_plat_caps *caps;
+	unsigned int levels_count;
+	unsigned int i;
+	bool found = false;
+	u32 hfi_level;
+	u32 level;
+
+	switch (hfi_codec) {
+	case HFI_VIDEO_CODEC_H264:
+		levels = h264_levels;
+		levels_count = ARRAY_SIZE(h264_levels);
+		break;
+	case HFI_VIDEO_CODEC_MPEG2:
+		levels = mpeg2_levels;
+		levels_count = ARRAY_SIZE(mpeg2_levels);
+		break;
+	case HFI_VIDEO_CODEC_MPEG4:
+		levels = mpeg4_levels;
+		levels_count = ARRAY_SIZE(mpeg4_levels);
+		break;
+	case HFI_VIDEO_CODEC_VP9:
+		levels = vp9_levels;
+		levels_count = ARRAY_SIZE(vp9_levels);
+		break;
+	case HFI_VIDEO_CODEC_HEVC:
+		levels = hevc_levels;
+		levels_count = ARRAY_SIZE(hevc_levels);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	caps = venus_caps_by_codec(core, hfi_codec, domain);
+	if (!caps)
+		return -EINVAL;
+
+	*max_level = 0;
+	for (i = 0; i < caps->num_pl; i++) {
+		hfi_level = caps->pl[i].level;
+		if (hfi_codec == HFI_VIDEO_CODEC_HEVC)
+			hfi_level &= GENMASK(27, 0);
+		if (!find_v4l2_id_checked(hfi_level, levels,
+					  levels_count, &level))
+			continue;
+		*max_level = max(*max_level, level);
+		found = true;
+	}
+
+	return found ? 0 : -EINVAL;
+}
+EXPORT_SYMBOL_GPL(venus_helper_get_max_level);
+
 static void
 hfi_id_profile_level(u32 hfi_codec, u32 v4l2_pf, u32 v4l2_lvl, struct hfi_profile_level *pl)
 {
@@ -1156,7 +1297,8 @@ int venus_helper_get_profile_level(struct venus_inst *inst, u32 *profile, u32 *l
 	if (ret)
 		return ret;
 
-	v4l2_id_profile_level(inst->hfi_codec, &hprop.profile_level, profile, level);
+	v4l2_id_profile_level(inst->hfi_codec, IS_IRIS1(inst->core),
+			      &hprop.profile_level, profile, level);
 
 	return 0;
 }
@@ -1169,6 +1311,11 @@ int venus_helper_set_profile_level(struct venus_inst *inst, u32 profile,
 	struct hfi_profile_level pl;
 
 	hfi_id_profile_level(inst->hfi_codec, profile, level, &pl);
+	if (IS_IRIS1(inst->core) && inst->hfi_codec == HFI_VIDEO_CODEC_VP8) {
+		pl.profile = HFI_VPX_PROFILE_MAIN;
+		pl.level = find_hfi_id(profile, vp8_levels,
+				       ARRAY_SIZE(vp8_levels));
+	}
 	/*
 	 * The downstream VPU5 control defaults to H.264 LEVEL_UNKNOWN (zero),
 	 * allowing firmware to select a valid level from resolution and bitrate.
diff --git a/drivers/media/platform/qcom/venus/helpers.h b/drivers/media/platform/qcom/venus/helpers.h
index 0b35ac8f8a68..903f65423e26 100644
--- a/drivers/media/platform/qcom/venus/helpers.h
