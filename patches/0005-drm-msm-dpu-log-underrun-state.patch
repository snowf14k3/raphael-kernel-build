diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index eba1d5221..bd5531ea9 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -1492,12 +1492,31 @@ void dpu_encoder_vblank_callback(struct drm_encoder *drm_enc,
 void dpu_encoder_underrun_callback(struct drm_encoder *drm_enc,
 		struct dpu_encoder_phys *phy_enc)
 {
+	int intf = -1, pp = -1, ctl = -1;
+
 	if (!phy_enc)
 		return;
 
 	DPU_ATRACE_BEGIN("encoder_underrun_callback");
 	atomic_inc(&phy_enc->underrun_cnt);
 
+	if (phy_enc->hw_intf)
+		intf = phy_enc->hw_intf->idx - INTF_0;
+	if (phy_enc->hw_pp)
+		pp = phy_enc->hw_pp->idx - PINGPONG_0;
+	if (phy_enc->hw_ctl)
+		ctl = phy_enc->hw_ctl->idx - CTL_0;
+
+	DPU_ERROR_RATELIMITED(
+		"underrun enc=%d intf=%d pp=%d ctl=%d intf_mode=%d state=%d cnt=%d kickoff=%d ctlstart=%d vsync=%d mode=%dx%d clock=%d\n",
+		DRMID(drm_enc), intf, pp, ctl, phy_enc->intf_mode,
+		phy_enc->enable_state, atomic_read(&phy_enc->underrun_cnt),
+		atomic_read(&phy_enc->pending_kickoff_cnt),
+		atomic_read(&phy_enc->pending_ctlstart_cnt),
+		atomic_read(&phy_enc->vsync_cnt),
+		phy_enc->cached_mode.hdisplay, phy_enc->cached_mode.vdisplay,
+		phy_enc->cached_mode.clock);
+
 	/* trigger dump only on the first underrun */
 	if (atomic_read(&phy_enc->underrun_cnt) == 1)
 		msm_disp_snapshot_state(drm_enc->dev);
