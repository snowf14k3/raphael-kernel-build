From 1c12ad59a345ec7e146f4a64510ba82c83614240 Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Sun, 13 Sep 2026 11:51:26 +0800
Subject: [PATCH] media: venus: use mapped IRIS1 decoder EOS buffer

---
 drivers/media/platform/qcom/venus/core.h |  4 ++
 drivers/media/platform/qcom/venus/vdec.c | 55 +++++++++++++++++++++---
 2 files changed, 53 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/core.h b/drivers/media/platform/qcom/venus/core.h
index e3b615312..876bcec33 100644
--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -449,6 +449,8 @@ enum venus_inst_modes {
  * @pic_struct:		bitstream progressive vs interlaced
  * @next_buf_last: a flag to mark next queued capture buffer as last
  * @drain_active:	Drain sequence is in progress
+ * @eos_buf:	IRIS1 decoder EOS buffer CPU address
+ * @eos_da:		IRIS1 decoder EOS buffer DMA address
  * @flags:	bitmask flags describing current instance mode
  * @dpb_ids:	DPB buffer ID's
  */
@@ -520,6 +522,8 @@ struct venus_inst {
 	unsigned int pic_struct;
 	bool next_buf_last;
 	bool drain_active;
+	void *eos_buf;
+	dma_addr_t eos_da;
 	enum venus_inst_modes flags;
 	struct ida dpb_ids;
 };
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 553554fcd..17fa9f499 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -4,6 +4,7 @@
  * Copyright (C) 2017 Linaro Ltd.
  */
 #include <linux/clk.h>
+#include <linux/dma-mapping.h>
 #include <linux/module.h>
 #include <linux/mod_devicetable.h>
 #include <linux/platform_device.h>
@@ -545,6 +546,35 @@ static int vdec_subscribe_event(struct v4l2_fh *fh,
 	}
 }
 
+#define VENUS_DEC_EOS_TAG U32_MAX
+
+static int vdec_alloc_eos_buffer(struct venus_inst *inst)
+{
+	if (inst->eos_buf)
+		return 0;
+
+	inst->eos_buf = dma_alloc_attrs(inst->core->dev, SZ_4K, &inst->eos_da,
+					GFP_KERNEL, DMA_ATTR_WRITE_COMBINE |
+					DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!inst->eos_buf) {
+		inst->eos_da = 0;
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+static void vdec_free_eos_buffer(struct venus_inst *inst)
+{
+	if (!inst->eos_buf)
+		return;
+
+	dma_free_attrs(inst->core->dev, SZ_4K, inst->eos_buf, inst->eos_da,
+		       DMA_ATTR_WRITE_COMBINE | DMA_ATTR_NO_KERNEL_MAPPING);
+	inst->eos_buf = NULL;
+	inst->eos_da = 0;
+}
+
 static int
 vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 {
@@ -570,15 +600,24 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 		fdata.buffer_type = HFI_BUFFER_INPUT;
 		fdata.flags |= HFI_BUFFERFLAG_EOS;
 
-		/* Send NULL EOS addr for only IRIS2 (SM8250),for firmware <= 1.0.87.
-		 * SC7280 also reports "1.0.<hash>" parsed as 1.0.0; restricting to IRIS2
-		 * avoids misapplying this quirk and breaking VP9 decode on SC7280.
+		/*
+		 * SM8150 validates the EOS packet address for VPx and MPEG-2.
+		 * Keep a mapped input-sized token alive until the session is gone,
+		 * matching the downstream driver's EOS-buffer contract.
 		 */
-
-		if (IS_IRIS2(inst->core) && is_fw_rev_or_older(inst->core, 1, 0, 87))
+		if (IS_IRIS1(inst->core)) {
+			ret = vdec_alloc_eos_buffer(inst);
+			if (ret)
+				goto unlock;
+			fdata.alloc_len = SZ_4K;
+			fdata.device_addr = inst->eos_da;
+			fdata.clnt_data = VENUS_DEC_EOS_TAG;
+		} else if (IS_IRIS2(inst->core) &&
+			   is_fw_rev_or_older(inst->core, 1, 0, 87)) {
 			fdata.device_addr = 0;
-		else
+		} else {
 			fdata.device_addr = 0xdeadb000;
+		}
 
 		ret = hfi_session_process_buf(inst, &fdata);
 
@@ -1343,6 +1382,7 @@ static void vdec_session_release(struct venus_inst *inst)
 	if (abort)
 		hfi_session_abort(inst);
 
+	vdec_free_eos_buffer(inst);
 	venus_helper_free_dpb_bufs(inst);
 	venus_pm_load_scale(inst);
 	INIT_LIST_HEAD(&inst->registeredbufs);
@@ -1426,6 +1466,9 @@ static void vdec_buf_done(struct venus_inst *inst, unsigned int buf_type,
 
 	vdec_pm_touch(inst);
 
+	if (buf_type == HFI_BUFFER_INPUT && tag == VENUS_DEC_EOS_TAG)
+		return;
+
 	if (buf_type == HFI_BUFFER_INPUT)
 		type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
 	else
-- 
2.43.0

