+/*
+ * VPU5/HFI4 appends encoder reconstruction statistics to EBD messages.  Keep
+ * this as a tail structure so older firmware messages remain valid and the
+ * common EBD prefix above stays the minimum accepted packet size.
+ */
+struct hfi_ubwc_cr_stats_info {
+	u32 info[7];
+};
+
+struct hfi_frame_cr_stats {
+	u32 frame_index;
+	struct hfi_ubwc_cr_stats_info ubwc;
+	u32 complexity_number;
+};
+
+struct hfi_msg_session_empty_buffer_done_v4_tail {
+	u32 flags;
+	struct hfi_frame_cr_stats recon;
+	u32 is_sync_frame;
+	u32 data[];
+};
+
 struct hfi_msg_session_fbd_compressed_pkt {
 	struct hfi_session_hdr_pkt shdr;
 	u32 time_stamp_hi;
