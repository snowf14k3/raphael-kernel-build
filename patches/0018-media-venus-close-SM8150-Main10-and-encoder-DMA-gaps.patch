+#include <linux/math64.h>
 #include <linux/slab.h>
 #include <linux/soc/qcom/smem.h>
 #include <media/videobuf2-v4l2.h>
@@ -545,10 +546,67 @@ static void hfi_session_etb_done(struct venus_core *core,
 				 struct venus_inst *inst, void *packet)
 {
 	struct hfi_msg_session_empty_buffer_done_pkt *pkt = packet;
+	u32 hfi_flags = 0;
+
+	if (IS_IRIS1(core) && inst->session_type == VIDC_SESSION_TYPE_ENC &&
+	    pkt->shdr.hdr.size >= sizeof(*pkt) +
+				  sizeof(struct hfi_msg_session_empty_buffer_done_v4_tail)) {
+		const struct hfi_msg_session_empty_buffer_done_v4_tail *tail;
+		static const u16 ubwc_bucket_weights[] = {
+			32, 64, 96, 128, 160, 192, 256,
+		};
+		u64 weighted_sum = 0, sum = 0, numerator;
+		u32 cr_q16 = 0, cf_q16, frame_size;
+		u32 mbs_per_frame, picture_type = 0;
+		u32 ebd_count;
+		unsigned int i;
+
+		tail = (const void *)pkt->data;
+		hfi_flags = tail->flags;
+
+		for (i = 0; i < ARRAY_SIZE(tail->recon.ubwc.info); i++) {
+			u64 samples = tail->recon.ubwc.info[i];
+
+			sum += samples;
+			weighted_sum += ubwc_bucket_weights[i] * samples;
+		}
+
+		if (sum && weighted_sum) {
+			numerator = (256 * sum) << 16;
+			cr_q16 = div64_u64(numerator, weighted_sum);
+		}
+
+		mbs_per_frame = (ALIGN(max(inst->width, inst->out_width), 16) / 16) *
+				(ALIGN(max(inst->height, inst->out_height), 16) / 16);
+		frame_size = (mbs_per_frame / (32 * 8) * 3) / 2;
+		cf_q16 = frame_size ? tail->recon.complexity_number / frame_size :
+				      4 << 16;
+
+		WRITE_ONCE(inst->enc_recon_index, tail->recon.frame_index);
+		WRITE_ONCE(inst->enc_ubwc_cr_q16, cr_q16);
+		WRITE_ONCE(inst->enc_complexity_factor_q16, cf_q16);
+		WRITE_ONCE(inst->enc_complexity_number,
+			   tail->recon.complexity_number);
+		ebd_count = READ_ONCE(inst->enc_ebd_count) + 1;
+		WRITE_ONCE(inst->enc_ebd_count, ebd_count);
+
+		if (tail->is_sync_frame &&
+		    pkt->shdr.hdr.size >= sizeof(*pkt) + sizeof(*tail) +
+					  sizeof(picture_type))
+			picture_type = tail->data[0];
+
+		if (ebd_count <= 4 || !(ebd_count % 60))
+			dev_info(core->dev,
+				 "sm8150-venus: EBD count=%u tag=%u flags=%#x recon=%u cr_q16=%u cf_q16=%u complexity=%u sync=%u picture=%#x\n",
+				 ebd_count, pkt->input_tag, hfi_flags,
+				 tail->recon.frame_index, cr_q16, cf_q16,
+				 tail->recon.complexity_number,
+				 tail->is_sync_frame, picture_type);
+	}
 
 	inst->error = pkt->error_type;
 	inst->ops->buf_done(inst, HFI_BUFFER_INPUT, pkt->input_tag,
-			    pkt->filled_len, pkt->offset, 0, 0, 0);
+			    pkt->filled_len, pkt->offset, 0, hfi_flags, 0);
 }
 
