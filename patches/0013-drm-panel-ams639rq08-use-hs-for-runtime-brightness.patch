From 5f6e6e79d2e3b0d606f935b9e15609d26942943a Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Tue, 8 Sep 2026 19:02:00 +0800
Subject: [PATCH 13/13] drm/panel: ams639rq08: use HS for runtime brightness

The panel's original brightness path selected high-speed transmission.
Keep that requirement while retaining the request coalescing added by the
previous change.  On Raphael, low-power brightness transfers issued while
GNOME is continuously repainting trigger DSI timeout and FIFO errors
(dsi_err_worker state 0x5), even with the command rate limited to 10 Hz.

Save and restore all mode flags around the transfer so an error cannot leave
the peripheral in the temporary mode.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 drivers/gpu/drm/panel/panel-samsung-ams639rq08.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ams639rq08.c b/drivers/gpu/drm/panel/panel-samsung-ams639rq08.c
index a3f0223aeb5c..efc22bd45993 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ams639rq08.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ams639rq08.c
@@ -231,6 +231,7 @@ static void ams639rq08_brightness_work(struct work_struct *work)
 	struct ams639rq08 *ctx =
 		container_of(to_delayed_work(work), struct ams639rq08,
 			     brightness_work);
+	unsigned long mode_flags;
 	u16 brightness;
 	int ret;
 
@@ -241,8 +242,11 @@ static void ams639rq08_brightness_work(struct work_struct *work)
 	brightness = ctx->pending_brightness;
 	ctx->brightness_pending = false;
 
-	/* Runtime DCS commands for this panel are sent in low-power mode. */
+	/* The panel requires runtime brightness commands in high-speed mode. */
+	mode_flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi, brightness);
+	ctx->dsi->mode_flags = mode_flags;
 	ctx->last_brightness_update = jiffies;
 	if (ret < 0) {
 		ctx->brightness_pending = true;
-- 
