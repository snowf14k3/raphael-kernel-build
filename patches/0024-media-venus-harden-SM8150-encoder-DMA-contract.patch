From: Codex <codex@openai.com>
Date: Wed, 9 Sep 2026 02:30:00 +0800
Subject: [PATCH 24/28] media: venus: harden SM8150 encoder DMA contract

The SM8150 encoder hard-resets the device as soon as the first ETB is
submitted when the host and firmware disagree about an external buffer.
The downstream driver obtains both external queue contracts from firmware
before allocating buffers and treats the returned compressed-output size
as authoritative.

Do the same for IRIS1: query and validate each queue requirement during
REQBUFS, allocate the firmware-requested number and exact compressed size,
and stop sending the BUFFER_SIZE_ACTUAL property which downstream never
sends.  Validate the final queue size and count again at STREAMON.

Before every ETB/FTB, reject zero, overflowing, truncated or misaligned DMA
ranges.  Also validate firmware's encoded-frame offset and payload before
returning a capture buffer to userspace, using V4L2's bytesused semantics
rather than folding data_offset into the payload length.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/media/platform/qcom/venus/helpers.c | 50 +++++++++++++--
 drivers/media/platform/qcom/venus/venc.c    | 99 ++++++++++++++++++++++-------
 2 files changed, 127 insertions(+), 22 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
index b31a19967259..cb0307e16336 100644
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -581,17 +581,26 @@ session_process_buf(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 	struct vb2_buffer *vb = &vbuf->vb2_buf;
 	unsigned int type = vb->type;
 	struct hfi_frame_data fdata;
+	struct hfi_buffer_requirements req;
+	u32 dma_addr;
 	int ret;
 
 	memset(&fdata, 0, sizeof(fdata));
-	if (upper_32_bits(buf->dma_addr)) {
+	if (!buf->size || upper_32_bits(buf->dma_addr)) {
 		dev_err(inst->core->dev,
-			"Venus frame DMA address %pad does not fit the HFI address field\n",
-			&buf->dma_addr);
+			"invalid Venus frame DMA range address=%pad size=%u\n",
+			&buf->dma_addr, buf->size);
+		return -ERANGE;
+	}
+	dma_addr = lower_32_bits(buf->dma_addr);
+	if (dma_addr > U32_MAX - (buf->size - 1)) {
+		dev_err(inst->core->dev,
+			"Venus frame DMA range crosses 32-bit HFI boundary address=%pad size=%u\n",
+			&buf->dma_addr, buf->size);
 		return -ERANGE;
 	}
 	fdata.alloc_len = buf->size;
-	fdata.device_addr = buf->dma_addr;
+	fdata.device_addr = dma_addr;
 	fdata.timestamp = vb->timestamp;
 	do_div(fdata.timestamp, NSEC_PER_USEC);
 	fdata.flags = 0;
@@ -618,6 +627,39 @@ session_process_buf(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 			fdata.buffer_type = inst->opb_buftype;
 		fdata.filled_len = 0;
 		fdata.offset = 0;
+	} else {
+		return -EINVAL;
+	}
+
+	if (fdata.offset > fdata.alloc_len ||
+	    fdata.filled_len > fdata.alloc_len - fdata.offset) {
+		dev_err(inst->core->dev,
+			"Venus frame payload outside buffer: type=%#x alloc=%u filled=%u offset=%u\n",
+			fdata.buffer_type, fdata.alloc_len,
+			fdata.filled_len, fdata.offset);
+		return -EINVAL;
+	}
+
+	/*
+	 * The SM8150 firmware publishes the alignment and minimum allocation for
+	 * both externally supplied encoder queues.  Validate the actual VB2 DMA
+	 * object immediately before constructing ETB/FTB, so a bad userspace
+	 * import cannot turn into an unchecked VPU5 bus transaction.
+	 */
+	if (IS_IRIS1(inst->core) &&
+	    inst->session_type == VIDC_SESSION_TYPE_ENC) {
+		ret = venus_helper_get_bufreq(inst, fdata.buffer_type, &req);
+		if (ret)
+			return ret;
+		if (fdata.alloc_len < req.size ||
+		    (req.alignment &&
+		     !IS_ALIGNED(fdata.device_addr, req.alignment))) {
+			dev_err(inst->core->dev,
+				"refusing encoder DMA: type=%#x dma=%#x alloc=%u required=%u align=%u\n",
+				fdata.buffer_type, fdata.device_addr,
+				fdata.alloc_len, req.size, req.alignment);
+			return -EINVAL;
+		}
 	}
 
 	if (IS_IRIS1(inst->core) &&
diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index 21b6fb18128d..0c169da64395 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -1465,13 +1465,38 @@ static int venc_out_num_buffers(struct venus_inst *inst, unsigned int *num)
 	return 0;
 }
 
+static int venc_iris1_validate_external_req(struct venus_inst *inst,
+					    u32 type,
+					    const struct hfi_buffer_requirements *req)
+{
+	enum hfi_version ver = inst->core->res->hfi_version;
+	u32 count_min = hfi_bufreq_get_count_min(req, ver);
+	u32 count_host = hfi_bufreq_get_count_min_host(req, ver);
+
+	if (req->type != type || !req->size || !req->count_actual ||
+	    !count_min || req->count_actual < count_min ||
+	    req->count_actual > VIDEO_MAX_FRAME ||
+	    count_min > VIDEO_MAX_FRAME || count_host > VIDEO_MAX_FRAME ||
+	    (req->alignment && !is_power_of_2(req->alignment))) {
+		dev_err(inst->core->dev,
+			"invalid encoder queue requirement type=%#x/%#x size=%u actual=%u min=%u host=%u align=%u\n",
+			type, req->type, req->size, req->count_actual,
+			count_min, count_host, req->alignment);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
 static int venc_queue_setup(struct vb2_queue *q,
 			    unsigned int *num_buffers, unsigned int *num_planes,
 			    unsigned int sizes[], struct device *alloc_devs[])
 {
 	struct venus_inst *inst = vb2_get_drv_priv(q);
 	struct venus_core *core = inst->core;
+	struct hfi_buffer_requirements iris1_req = {};
 	unsigned int num, min = VENUS_IRIS1_ENC_MIN_BUFFERS;
+	enum hfi_version ver = core->res->hfi_version;
 	int ret;
 
 	if (*num_planes) {
@@ -1510,6 +1535,16 @@ static int venc_queue_setup(struct vb2_queue *q,
 
 	mutex_lock(&inst->lock);
 	ret = venc_init_session(inst);
+	if (!ret && IS_IRIS1(core)) {
+		u32 type = V4L2_TYPE_IS_OUTPUT(q->type) ?
+			HFI_BUFFER_INPUT : HFI_BUFFER_OUTPUT;
+
+		/* Downstream obtains the external queue contract from firmware. */
+		ret = venus_helper_get_bufreq(inst, type, &iris1_req);
+		if (!ret)
+			ret = venc_iris1_validate_external_req(inst, type,
+							       &iris1_req);
+	}
 	mutex_unlock(&inst->lock);
 
 	if (ret)
@@ -1523,9 +1558,10 @@ static int venc_queue_setup(struct vb2_queue *q,
 	case V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE:
 		*num_planes = inst->fmt_out->num_planes;
 
-		/* VPU5 obtains its coherent requirements table at STREAMON. */
 		if (IS_IRIS1(core)) {
-			num = min;
+			num = max3(iris1_req.count_actual,
+				   hfi_bufreq_get_count_min(&iris1_req, ver),
+				   hfi_bufreq_get_count_min_host(&iris1_req, ver));
 		} else {
 			ret = venc_out_num_buffers(inst, &num);
 			if (ret)
@@ -1546,13 +1582,29 @@ static int venc_queue_setup(struct vb2_queue *q,
 		break;
 	case V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE:
 		*num_planes = inst->fmt_cap->num_planes;
-		*num_buffers = max(*num_buffers, min);
+		if (IS_IRIS1(core))
+			num = max3(iris1_req.count_actual,
+				   hfi_bufreq_get_count_min(&iris1_req, ver),
+				   hfi_bufreq_get_count_min_host(&iris1_req, ver));
+		else
+			num = min;
+		num = max(num, min);
+		*num_buffers = max(*num_buffers, num);
 		inst->num_output_bufs = *num_buffers;
-		sizes[0] = venus_helper_get_framesz(inst->fmt_cap->pixfmt,
-						    inst->width,
-						    inst->height);
-		sizes[0] = max(sizes[0], inst->output_buf_size);
+		if (IS_IRIS1(core)) {
+			/* The compressed CAPTURE size is a firmware contract. */
+			sizes[0] = iris1_req.size;
+		} else {
+			sizes[0] = venus_helper_get_framesz(inst->fmt_cap->pixfmt,
+							    inst->width,
+							    inst->height);
+			sizes[0] = max(sizes[0], inst->output_buf_size);
+		}
 		inst->output_buf_size = sizes[0];
+		if (IS_IRIS1(core))
+			dev_info(core->dev,
+				 "venus-sm8150: encoder bitstream buffers size=%u count=%u firmware-defined\n",
+				 sizes[0], *num_buffers);
 		break;
 	default:
 		ret = -EINVAL;
@@ -1654,7 +1706,8 @@ static int venc_verify_conf(struct venus_inst *inst)
 		return ret;
 
 	if (inst->num_output_bufs < bufreq.count_actual ||
-	    inst->num_output_bufs < hfi_bufreq_get_count_min(&bufreq, ver))
+	    inst->num_output_bufs < hfi_bufreq_get_count_min(&bufreq, ver) ||
+	    inst->output_buf_size < bufreq.size)
 		return -EINVAL;
 
 	ret = venus_helper_get_bufreq(inst, HFI_BUFFER_INPUT, &bufreq);
@@ -1662,7 +1715,8 @@ static int venc_verify_conf(struct venus_inst *inst)
 		return ret;
 
 	if (inst->num_input_bufs < bufreq.count_actual ||
-	    inst->num_input_bufs < hfi_bufreq_get_count_min(&bufreq, ver))
+	    inst->num_input_bufs < hfi_bufreq_get_count_min(&bufreq, ver) ||
+	    inst->input_buf_size < bufreq.size)
 		return -EINVAL;
 
 	return 0;
@@ -1901,15 +1955,12 @@ static int venc_start_streaming(struct vb2_queue *q, unsigned int count)
 		goto error;
 
 	if (IS_IRIS1(inst->core)) {
-		ret = venus_helper_set_bufsize(inst, inst->output_buf_size,
-					       HFI_BUFFER_OUTPUT);
-		if (ret)
-			goto error;
-
 		/*
-		 * SET_BUFFER_COUNT and SET_BUFFER_SIZE can change scratch and
-		 * persistent requirements.  The internal-buffer allocator must only
+		 * SET_BUFFER_COUNT can change scratch and persistent requirements.
+		 * The internal-buffer allocator must only
 		 * consume a fresh, coherent table, just like the downstream driver.
+		 * Do not send BUFFER_SIZE_ACTUAL for the encoder: downstream treats
+		 * the firmware's OUTPUT requirement as authoritative.
 		 */
 		ret = venus_helper_cache_bufreqs(inst);
 		if (ret)
@@ -2024,6 +2075,7 @@ static void venc_buf_done(struct venus_inst *inst, unsigned int buf_type,
 			  u32 hfi_flags, u64 timestamp_us)
 {
+	enum vb2_buffer_state state = VB2_BUF_STATE_DONE;
 	struct vb2_v4l2_buffer *vbuf;
 	struct vb2_buffer *vb;
 	unsigned int type;
 
@@ -2042,8 +2094,19 @@ static void venc_buf_done(struct venus_inst *inst, unsigned int buf_type,
 	vbuf->flags = flags;
 
 	if (type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+		unsigned long length;
+
 		vb = &vbuf->vb2_buf;
-		vb2_set_plane_payload(vb, 0, bytesused + data_offset);
+		length = vb2_plane_size(vb, 0);
+		if (data_offset > length || bytesused > length - data_offset) {
+			dev_err(inst->core->dev_enc,
+				"encoder payload outside buffer: offset=%u bytes=%u length=%lu\n",
+				data_offset, bytesused, length);
+			data_offset = 0;
+			bytesused = 0;
+			state = VB2_BUF_STATE_ERROR;
+		}
+		vb2_set_plane_payload(vb, 0, bytesused);
 		vb->planes[0].data_offset = data_offset;
 		vb->timestamp = timestamp_us * NSEC_PER_USEC;
 		vbuf->sequence = inst->sequence_cap++;
@@ -2055,7 +2118,7 @@ static void venc_buf_done(struct venus_inst *inst, unsigned int buf_type,
 		vbuf->sequence = inst->sequence_out++;
 	}
 
-	v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_DONE);
+	v4l2_m2m_buf_done(vbuf, state);
 }
 
 static void venc_event_notify(struct venus_inst *inst, u32 event,
