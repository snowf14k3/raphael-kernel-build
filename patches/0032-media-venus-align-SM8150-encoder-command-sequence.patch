--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -1553,14 +1553,14 @@ static u32 venus_helper_get_work_mode(struct venus_inst *inst)
 			mode = VIDC_WORK_MODE_1;
 	} else if (IS_IRIS1(inst->core)) {
 		/*
-		 * Downstream SM8150 selects mode 1 for RC_OFF/CBR/CQ and
-		 * mode 2 only for VBR-family encoder sessions.  Mode 1 also
-		 * requires the low-latency property sent by the caller.
+		 * Downstream VPU5 defaults normal H.264/HEVC encoding to mode 2.
+		 * VP8 and the CBR low-latency path use mode 1.
 		 */
-		mode = VIDC_WORK_MODE_1;
-		if (ctr->rc_enable &&
-		    ctr->bitrate_mode == V4L2_MPEG_VIDEO_BITRATE_MODE_VBR)
-			mode = VIDC_WORK_MODE_2;
+		mode = VIDC_WORK_MODE_2;
+		if (inst->hfi_codec == HFI_VIDEO_CODEC_VP8 ||
+		    (ctr->rc_enable &&
+		     ctr->bitrate_mode == V4L2_MPEG_VIDEO_BITRATE_MODE_CBR))
+			mode = VIDC_WORK_MODE_1;
 	} else {
 		num_mbs = (ALIGN(inst->out_height, 16) * ALIGN(inst->out_width, 16)) / 256;
 		if (inst->hfi_codec == HFI_VIDEO_CODEC_VP8 &&
@@ -1728,28 +1728,18 @@ int venus_helper_set_num_bufs(struct venus_inst *inst, unsigned int input_bufs,
 	enum hfi_version ver = inst->core->res->hfi_version;
 	bool iris1_decoder = IS_IRIS1(inst->core) &&
 		inst->session_type == VIDC_SESSION_TYPE_DEC;
-	bool iris1_encoder = IS_IRIS1(inst->core) &&
-		inst->session_type == VIDC_SESSION_TYPE_ENC;
 	int ret;
 
 	buf_count.type = HFI_BUFFER_INPUT;
 	buf_count.count_actual = input_bufs;
 	buf_count.count_min_host = input_bufs;
-	if (iris1_decoder ||
-	    (iris1_encoder && inst->bufreq_cache_valid)) {
+	if (iris1_decoder) {
 		/* Match downstream queue_setup: advertise the firmware minimum. */
 		ret = venus_helper_get_bufreq(inst, HFI_BUFFER_INPUT, &bufreq);
 		if (ret)
 			return ret;
 		buf_count.count_min_host = hfi_bufreq_get_count_min(&bufreq, ver);
 	}
-	if (iris1_encoder) {
-		dev_info(inst->core->dev,
-			 "venus-sm8150: input buffers actual=%u host-min=%u source=%s\n",
-			 buf_count.count_actual, buf_count.count_min_host,
-			 inst->bufreq_cache_valid ? "firmware" : "initial");
-	}
-
 	ret = hfi_session_set_property(inst, ptype, &buf_count);
 	if (ret)
 		return ret;
@@ -1757,21 +1747,13 @@ int venus_helper_set_num_bufs(struct venus_inst *inst, unsigned int input_bufs,
 	buf_count.type = HFI_BUFFER_OUTPUT;
 	buf_count.count_actual = output_bufs;
 	buf_count.count_min_host = output_bufs;
-	if (iris1_decoder ||
-	    (iris1_encoder && inst->bufreq_cache_valid)) {
+	if (iris1_decoder) {
 		/* Match downstream queue_setup: advertise the firmware minimum. */
 		ret = venus_helper_get_bufreq(inst, HFI_BUFFER_OUTPUT, &bufreq);
 		if (ret)
 			return ret;
 		buf_count.count_min_host = hfi_bufreq_get_count_min(&bufreq, ver);
 	}
-	if (iris1_encoder) {
-		dev_info(inst->core->dev,
-			 "venus-sm8150: output buffers actual=%u host-min=%u source=%s\n",
-			 buf_count.count_actual, buf_count.count_min_host,
-			 inst->bufreq_cache_valid ? "firmware" : "initial");
-	}
-
 	ret = hfi_session_set_property(inst, ptype, &buf_count);
 	if (ret)
 		return ret;
