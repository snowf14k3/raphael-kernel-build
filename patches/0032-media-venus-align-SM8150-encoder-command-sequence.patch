 	return qp_i | (qp_p << 8) | (qp_b << 16);
 }
 
+static bool venc_iris1_default_frame_qp(struct venus_inst *inst)
+{
+	struct venc_controls *ctr = &inst->controls.enc;
+
+	if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_HEVC)
+		return ctr->hevc_i_qp == 26 && ctr->hevc_p_qp == 28 &&
+		       ctr->hevc_b_qp == 30;
+
+	return ctr->h264_i_qp == 26 && ctr->h264_p_qp == 28 &&
+	       ctr->h264_b_qp == 30;
+}
+
+static bool venc_iris1_default_qp_range(struct venus_inst *inst)
+{
+	struct venc_controls *ctr = &inst->controls.enc;
+
+	if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_HEVC)
+		return ctr->hevc_i_min_qp == 1 && ctr->hevc_p_min_qp == 1 &&
+		       ctr->hevc_b_min_qp == 1 && ctr->hevc_i_max_qp == 63 &&
+		       ctr->hevc_p_max_qp == 63 && ctr->hevc_b_max_qp == 63;
+	if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_VP8)
+		return ctr->vp8_min_qp == 1 && ctr->vp8_max_qp == 128;
+
+	return ctr->h264_i_min_qp == 1 && ctr->h264_p_min_qp == 1 &&
+	       ctr->h264_b_min_qp == 1 && ctr->h264_i_max_qp == 51 &&
+	       ctr->h264_p_max_qp == 51 && ctr->h264_b_max_qp == 51;
+}
+
+static bool venc_iris1_default_profile_level(struct venus_inst *inst)
+{
+	struct venc_controls *ctr = &inst->controls.enc;
+
+	if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_H264)
+		return ctr->profile.h264 == V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE &&
+		       ctr->level.h264 == V4L2_MPEG_VIDEO_H264_LEVEL_5_1;
+	if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_HEVC)
+		return ctr->profile.hevc == V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN &&
+		       ctr->level.hevc == V4L2_MPEG_VIDEO_HEVC_LEVEL_1 &&
+		       ctr->hevc_tier == V4L2_MPEG_VIDEO_HEVC_TIER_MAIN;
+	if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_VP8)
+		return ctr->profile.vp8 == V4L2_MPEG_VIDEO_VP8_PROFILE_0;
+
+	return false;
+}
