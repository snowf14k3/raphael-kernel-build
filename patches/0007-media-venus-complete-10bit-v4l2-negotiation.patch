From: snowf14k3 <snowf14k3@users.noreply.github.com>
Date: Tue, 8 Sep 2026 05:20:00 +0800
Subject: [PATCH] media: venus: complete 10-bit V4L2 negotiation

Align linear P010 buffers to the 256-byte hardware requirement documented
by both the SM8150 downstream driver and the Iris 10-bit implementation.

Keep format enumeration stable, but reject capture S_FMT/TRY_FMT requests
whose bit depth does not match the stream. Expose the standard HEVC profile
control, including Main10, so V4L2 userspace can negotiate the stream
profile. Use P010 as the safe 10-bit fallback and apply the corresponding
QC10C geometry when userspace selects compressed 10-bit output.

Signed-off-by: snowf14k3 <snowf14k3@users.noreply.github.com>
---
diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
index 4c235dd6739c..c9401d96ee98 100644
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -992,8 +992,12 @@ static u32 get_framesize_raw_p010(u32 width, u32 height)
 {
 	u32 y_plane, uv_plane, y_stride, uv_stride, y_sclines, uv_sclines;
 
-	y_stride = ALIGN(width * 2, 128);
-	uv_stride = ALIGN(width * 2, 128);
+	/*
+	 * P010 stores every 10-bit component in 16 bits. The Venus hardware
+	 * requires both linear planes to start on a 256-byte stride.
+	 */
+	y_stride = ALIGN(width * 2, 256);
+	uv_stride = ALIGN(width * 2, 256);
 	y_sclines = ALIGN(height, 32);
 	uv_sclines = ALIGN((height + 1) >> 1, 16);
 	y_plane = y_stride * y_sclines;
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index f2354951a0e3..07fccdd11859 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -113,6 +113,18 @@ static const struct venus_format vdec_formats[] = {
 
 };
 
+static bool vdec_fmt_is_8bit(u32 pixfmt)
+{
+	return pixfmt == V4L2_PIX_FMT_NV12 ||
+	       pixfmt == V4L2_PIX_FMT_QC08C;
+}
+
+static bool vdec_fmt_is_10bit(u32 pixfmt)
+{
+	return pixfmt == V4L2_PIX_FMT_P010 ||
+	       pixfmt == V4L2_PIX_FMT_QC10C;
+}
+
 static const struct venus_format *
 find_format(struct venus_inst *inst, u32 pixfmt, u32 type)
 {
@@ -136,9 +148,15 @@ find_format(struct venus_inst *inst, u32 pixfmt, u32 type)
 	    !venus_helper_check_format(inst, fmt[i].pixfmt))
 		return NULL;
 
-	if (V4L2_TYPE_IS_CAPTURE(type) && fmt[i].pixfmt == V4L2_PIX_FMT_QC10C &&
-	    !(inst->bit_depth == VIDC_BITDEPTH_10))
-		return NULL;
+	if (V4L2_TYPE_IS_CAPTURE(type)) {
+		if (vdec_fmt_is_8bit(fmt[i].pixfmt) &&
+		    inst->bit_depth == VIDC_BITDEPTH_10)
+			return NULL;
+
+		if (vdec_fmt_is_10bit(fmt[i].pixfmt) &&
+		    inst->bit_depth != VIDC_BITDEPTH_10)
+			return NULL;
+	}
 
 	return &fmt[i];
 }
@@ -163,10 +181,6 @@ find_format_by_index(struct venus_inst *inst, unsigned int index, u32 type)
 			valid = venus_helper_check_codec(inst, fmt[i].pixfmt);
 		} else {
 			valid = venus_helper_check_format(inst, fmt[i].pixfmt);
-
-			if (fmt[i].pixfmt == V4L2_PIX_FMT_QC10C &&
-			    !(inst->bit_depth == VIDC_BITDEPTH_10))
-				valid = false;
 		}
 
 		if (k == index && valid)
@@ -194,12 +208,16 @@ vdec_try_fmt_common(struct venus_inst *inst, struct v4l2_format *f)
 
 	fmt = find_format(inst, pixmp->pixelformat, f->type);
 	if (!fmt) {
-		if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
-			pixmp->pixelformat = V4L2_PIX_FMT_NV12;
-		else if (f->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+		if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+			if (inst->bit_depth == VIDC_BITDEPTH_10)
+				pixmp->pixelformat = V4L2_PIX_FMT_P010;
+			else
+				pixmp->pixelformat = V4L2_PIX_FMT_NV12;
+		} else if (f->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE) {
 			pixmp->pixelformat = V4L2_PIX_FMT_H264;
-		else
+		} else {
 			return NULL;
+		}
 		fmt = find_format(inst, pixmp->pixelformat, f->type);
 		if (!fmt)
 			return NULL;
@@ -210,8 +228,12 @@ vdec_try_fmt_common(struct venus_inst *inst, struct v4l2_format *f)
 	pixmp->height = clamp(pixmp->height, frame_height_min(inst),
 			      frame_height_max(inst));
 
-	if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
-		pixmp->height = ALIGN(pixmp->height, 32);
+	if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+		if (pixmp->pixelformat == V4L2_PIX_FMT_QC10C)
+			pixmp->height = ALIGN(pixmp->height, 16);
+		else
+			pixmp->height = ALIGN(pixmp->height, 32);
+	}
 
 	if (pixmp->field == V4L2_FIELD_ANY)
 		pixmp->field = V4L2_FIELD_NONE;
@@ -224,11 +246,17 @@ vdec_try_fmt_common(struct venus_inst *inst, struct v4l2_format *f)
 	if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
 		unsigned int stride = pixmp->width;
 
-		if (pixmp->pixelformat == V4L2_PIX_FMT_P010)
+		if (pixmp->pixelformat == V4L2_PIX_FMT_P010) {
 			stride *= 2;
+			pfmt[0].bytesperline = ALIGN(stride, 256);
+		} else if (pixmp->pixelformat == V4L2_PIX_FMT_QC10C) {
+			stride = stride * 4 / 3;
+			pfmt[0].bytesperline = ALIGN(stride, 256);
+		} else {
+			pfmt[0].bytesperline = ALIGN(stride, 128);
+		}
 
 		pfmt[0].sizeimage = szimage;
-		pfmt[0].bytesperline = ALIGN(stride, 128);
 	} else {
 		pfmt[0].sizeimage = clamp_t(u32, pfmt[0].sizeimage, 0, SZ_8M);
 		pfmt[0].sizeimage = max(pfmt[0].sizeimage, szimage);
diff --git a/drivers/media/platform/qcom/venus/vdec_ctrls.c b/drivers/media/platform/qcom/venus/vdec_ctrls.c
index 36ed955b0419..70fd063ee3c7 100644
--- a/drivers/media/platform/qcom/venus/vdec_ctrls.c
+++ b/drivers/media/platform/qcom/venus/vdec_ctrls.c
@@ -20,6 +20,7 @@ static int vdec_op_s_ctrl(struct v4l2_ctrl *ctrl)
 		ctr->post_loop_deb_mode = ctrl->val;
 		break;
 	case V4L2_CID_MPEG_VIDEO_H264_PROFILE:
+	case V4L2_CID_MPEG_VIDEO_HEVC_PROFILE:
 	case V4L2_CID_MPEG_VIDEO_MPEG4_PROFILE:
 	case V4L2_CID_MPEG_VIDEO_VP8_PROFILE:
 	case V4L2_CID_MPEG_VIDEO_VP9_PROFILE:
@@ -57,6 +58,7 @@ static int vdec_op_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
 
 	switch (ctrl->id) {
 	case V4L2_CID_MPEG_VIDEO_H264_PROFILE:
+	case V4L2_CID_MPEG_VIDEO_HEVC_PROFILE:
 	case V4L2_CID_MPEG_VIDEO_MPEG4_PROFILE:
 	case V4L2_CID_MPEG_VIDEO_VP8_PROFILE:
 	case V4L2_CID_MPEG_VIDEO_VP9_PROFILE:
@@ -98,7 +100,7 @@ int vdec_ctrl_init(struct venus_inst *inst)
 	struct v4l2_ctrl *ctrl;
 	int ret;
 
-	ret = v4l2_ctrl_handler_init(&inst->ctrl_handler, 12);
+	ret = v4l2_ctrl_handler_init(&inst->ctrl_handler, 13);
 	if (ret)
 		return ret;
 
@@ -111,6 +113,15 @@ int vdec_ctrl_init(struct venus_inst *inst)
 	if (ctrl)
 		ctrl->flags |= V4L2_CTRL_FLAG_VOLATILE;
 
+	ctrl = v4l2_ctrl_new_std_menu(&inst->ctrl_handler, &vdec_ctrl_ops,
+				      V4L2_CID_MPEG_VIDEO_HEVC_PROFILE,
+				      V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10,
+				      ~((1 << V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN) |
+					(1 << V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10)),
+				      V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_VOLATILE;
+
 	ctrl = v4l2_ctrl_new_std_menu(&inst->ctrl_handler, &vdec_ctrl_ops,
 				      V4L2_CID_MPEG_VIDEO_MPEG4_LEVEL,
 				      V4L2_MPEG_VIDEO_MPEG4_LEVEL_5,
