+/* Snapshot pending debug packets without consuming the firmware ring. */
+static void venus_peek_debug_queue(struct venus_hfi_device *hdev)
+{
+	struct iface_queue *queue = &hdev->queues[IFACEQ_DBG_IDX];
+	struct hfi_queue_header *qhdr = queue->qhdr;
+	u32 snapshot[128], *ring = queue->qmem.kva;
+	struct hfi_msg_sys_debug_pkt *pkt = (void *)snapshot;
+	u32 rd, wr, size, available, bytes, words, copied, i, count;
+
+	if (!qhdr || !ring)
+		return;
+	size = READ_ONCE(qhdr->q_size);
+	rd = READ_ONCE(qhdr->read_idx);
+	wr = READ_ONCE(qhdr->write_idx);
+	if (!size || size > queue->qmem.size / sizeof(u32) ||
+	    rd >= size || wr >= size)
+		return;
+	/* Pair the published write index with the packet payload. */
+	dma_rmb();
+	available = (wr + size - rd) % size;
+
+	for (count = 0; count < 3 && available; count++) {
+		bytes = READ_ONCE(ring[rd]);
+		if (bytes < sizeof(*pkt) || bytes % sizeof(u32))
+			break;
+		words = bytes / sizeof(u32);
+		if (words > available || bytes > IFACEQ_VAR_HUGE_PKT_SIZE)
+			break;
+		copied = min_t(u32, words, ARRAY_SIZE(snapshot));
+		for (i = 0; i < copied; i++)
+			snapshot[i] = READ_ONCE(ring[(rd + i) % size]);
+		if (pkt->hdr.pkt_type == HFI_MSG_SYS_DEBUG &&
+		    pkt->msg_size <= bytes - sizeof(*pkt)) {
+			u32 len = min_t(u32, pkt->msg_size,
+					copied * sizeof(u32) - sizeof(*pkt));
+
+			dev_err(hdev->core->dev, "venus-test4: pending FW debug: %.*s\n",
+				len, pkt->msg_data);
+		}
+		rd = (rd + words) % size;
+		available -= words;
+	}
+}
+
+/* Temporary IRIS1 bring-up diagnostics; callers must not hold hdev->lock. */
+void venus_hfi_dump_state(struct venus_core *core, const char *where, int error)
+{
+	struct venus_hfi_device *hdev = to_hfi_priv(core);
+	struct hfi_queue_header *qhdr;
+	unsigned int i;
+
+	if (!IS_IRIS1(core) || !hdev)
+		return;
+
+	/*
+	 * Read shared memory only: registers may be inaccessible during PM errors.
+	 * Firmware can still update these fields, so this is not an atomic snapshot.
+	 */
+	mutex_lock(&hdev->lock);
+	dev_err(core->dev,
+		"venus-test4: %s: ret=%d state=%u powered=%u suspended=%u last_cmd=%#x irq=%#x\n",
+		where, error, hdev->state, READ_ONCE(hdev->power_enabled),
+		READ_ONCE(hdev->suspended), hdev->last_packet_type,
+		READ_ONCE(hdev->irq_status));
+
+	/* Queue 0 = command, 1 = response, 2 = firmware debug; indices in u32s. */
+	for (i = 0; i < IFACEQ_NUM; i++) {
+		qhdr = hdev->queues[i].qhdr;
+		if (!qhdr)
+			continue;
+
+		dev_err(core->dev,
+			"venus-test4: q%u: rd=%u wr=%u size=%u rx_req=%u tx_req=%u dropped=%u\n",
+			i, READ_ONCE(qhdr->read_idx), READ_ONCE(qhdr->write_idx),
+			READ_ONCE(qhdr->q_size), READ_ONCE(qhdr->rx_req),
+			READ_ONCE(qhdr->tx_req), READ_ONCE(qhdr->pkt_drop_cnt));
+	}
+	venus_peek_debug_queue(hdev);
+	mutex_unlock(&hdev->lock);
+}
