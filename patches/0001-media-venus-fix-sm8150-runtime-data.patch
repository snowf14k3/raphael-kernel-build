+/* Temporary IRIS1 bring-up diagnostics; callers must not hold hdev->lock. */
+void venus_hfi_dump_state(struct venus_core *core, const char *where, int error)
+{
+	struct venus_hfi_device *hdev = to_hfi_priv(core);
+	struct hfi_queue_header *qhdr;
+	unsigned int i;
+
+	if (!IS_IRIS1(core) || !hdev)
+		return;
+
+	/*
+	 * Read shared memory only: registers may be inaccessible during PM errors.
+	 * Firmware can still update these fields, so this is not an atomic snapshot.
+	 */
+	mutex_lock(&hdev->lock);
+	dev_err(core->dev,
+		"venus-test3: %s: ret=%d state=%u powered=%u suspended=%u last_cmd=%#x irq=%#x\n",
+		where, error, hdev->state, READ_ONCE(hdev->power_enabled),
+		READ_ONCE(hdev->suspended), hdev->last_packet_type,
+		READ_ONCE(hdev->irq_status));
+
+	/* Queue 0 = command, 1 = response, 2 = firmware debug; indices in u32s. */
+	for (i = 0; i < IFACEQ_NUM; i++) {
+		qhdr = hdev->queues[i].qhdr;
+		if (!qhdr)
+			continue;
+
+		dev_err(core->dev,
+			"venus-test3: q%u: rd=%u wr=%u size=%u rx_req=%u tx_req=%u dropped=%u\n",
+			i, READ_ONCE(qhdr->read_idx), READ_ONCE(qhdr->write_idx),
+			READ_ONCE(qhdr->q_size), READ_ONCE(qhdr->rx_req),
+			READ_ONCE(qhdr->tx_req), READ_ONCE(qhdr->pkt_drop_cnt));
+	}
+	mutex_unlock(&hdev->lock);
+}
+
 static void venus_dump_packet(struct venus_hfi_device *hdev, const void *packet)
 {
 	size_t pkt_size = *(u32 *)packet;
@@ -1014,7 +1050,21 @@ static void venus_flush_debug_queue(struct venus_hfi_device *hdev)
 		if (pkt->hdr.pkt_type != HFI_MSG_SYS_COV) {
 			struct hfi_msg_sys_debug_pkt *pkt = packet;
 
-			dev_dbg(dev, VDBGFW "%s", pkt->msg_data);
+			if (IS_IRIS1(hdev->core)) {
+				unsigned int len;
+
+				if (pkt->hdr.pkt_type != HFI_MSG_SYS_DEBUG ||
+				    pkt->hdr.size < sizeof(*pkt) ||
+				    pkt->hdr.size > sizeof(hdev->dbg_buf))
+					continue;
+
+				len = min_t(unsigned int,
+					    pkt->hdr.size - sizeof(*pkt), 512);
+				dev_info_ratelimited(dev, "venus-test3: FW: %.*s\n",
+						     (int)len, pkt->msg_data);
+			} else {
+				dev_dbg(dev, VDBGFW "%s", pkt->msg_data);
+			}
 		}
 	}
 }
