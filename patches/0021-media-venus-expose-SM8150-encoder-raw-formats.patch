From: Codex <codex@openai.com>
Date: Tue, 8 Sep 2026 20:00:00 +0000
Subject: [PATCH] media: venus: expose SM8150 encoder raw formats

Port the downstream SM8150 encoder input-format contract instead of
advertising only linear NV12.

Expose the standard V4L2 counterparts for NV21, NV12 UBWC, TP10 UBWC and
P010, filter encoder raw formats against HFI input capabilities, and keep
the downstream NV21 capability which is absent from the generic HFI4
table.  Use the exact SM8150 stride, scanline, metadata and allocation
formulas for all exposed layouts.  Track 8/10-bit input depth and send the
required two-plane P010 constraints on HFI_BUFFER_INPUT.

The IRIS1 encoder safety gate remains disabled by default.

Signed-off-by: Codex <codex@openai.com>
---
diff --git a/drivers/media/platform/qcom/venus/core.h b/drivers/media/platform/qcom/venus/core.h
index 82e46f15c0f9f04b50abc5c2c6e5a2f078e93cea..31ed1df07adde95c5d540d59bd54b6a13bb6363e 100644
--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -127,6 +127,7 @@ enum venus_fmt {
 	VENUS_FMT_MPEG2			= 11,
 	VENUS_FMT_H263			= 12,
 	VENUS_FMT_XVID			= 13,
+	VENUS_FMT_NV21			= 14,
 };
 
 struct venus_format {
@@ -495,7 +496,7 @@ enum venus_inst_modes {
  * @drain_active:	Drain sequence is in progress
  * @enc_pm_active: encoder stream owns a runtime-PM reference
  * @enc_test_stage: snapshotted SM8150 encoder bring-up checkpoint
- * @enc_vendor_nv12: use the downstream SM8150 linear NV12 allocation formula
+ * @enc_vendor_nv12: use downstream SM8150 raw-input allocation formulas
  * @enc_dma_bidirectional: map raw encoder buffers for firmware read/write
  * @iris1_ebd_count: number of VPU5 input-done messages seen in this instance
  * @iris1_recon_index: latest VPU5 reconstruction-buffer index
diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
index 22d7afe3e14f2a4466d8c97ddecab1530504c9fa..1a3484126b51a45fbc3a6298589e13d33ec39498 100644
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -1469,10 +1469,32 @@ int venus_helper_set_work_route(struct venus_inst *inst)
 }
 EXPORT_SYMBOL_GPL(venus_helper_set_work_route);
 
-int venus_helper_set_format_constraints(struct venus_inst *inst)
+static int
+venus_helper_set_format_constraints_for_type(struct venus_inst *inst,
+					     u32 buffer_type,
+					     u32 stride_multiple)
 {
 	const u32 ptype = HFI_PROPERTY_PARAM_UNCOMPRESSED_PLANE_ACTUAL_CONSTRAINTS_INFO;
 	struct hfi_uncompressed_plane_actual_constraints_info pconstraint = {};
+
+	pconstraint.buffer_type = buffer_type;
+	pconstraint.num_planes = 2;
+	pconstraint.plane_format[0].stride_multiples = stride_multiple;
+	pconstraint.plane_format[0].max_stride = 8192;
+	pconstraint.plane_format[0].min_plane_buffer_height_multiple = 32;
+	pconstraint.plane_format[0].buffer_alignment = 256;
+
+	pconstraint.plane_format[1].stride_multiples = stride_multiple;
+	pconstraint.plane_format[1].max_stride = 8192;
+	pconstraint.plane_format[1].min_plane_buffer_height_multiple = 16;
+	pconstraint.plane_format[1].buffer_alignment = 256;
+
+	return hfi_session_set_property(inst, ptype, &pconstraint);
+}
+
+int venus_helper_set_format_constraints(struct venus_inst *inst)
+{
+	u32 buffer_type;
 	u32 stride_multiple;
 	int ret;
 
@@ -1487,30 +1509,38 @@ int venus_helper_set_format_constraints(struct venus_inst *inst)
 
 	/* SM8150/VPU5 requires 256-byte strides for linear P010 output. */
 	stride_multiple = IS_IRIS1(inst->core) ? 256 : 128;
+	buffer_type = IS_IRIS1(inst->core) ? inst->opb_buftype :
+						   HFI_BUFFER_OUTPUT2;
 
-	pconstraint.buffer_type = IS_IRIS1(inst->core) ? inst->opb_buftype :
-							       HFI_BUFFER_OUTPUT2;
-	pconstraint.num_planes = 2;
-	pconstraint.plane_format[0].stride_multiples = stride_multiple;
-	pconstraint.plane_format[0].max_stride = 8192;
-	pconstraint.plane_format[0].min_plane_buffer_height_multiple = 32;
-	pconstraint.plane_format[0].buffer_alignment = 256;
-
-	pconstraint.plane_format[1].stride_multiples = stride_multiple;
-	pconstraint.plane_format[1].max_stride = 8192;
-	pconstraint.plane_format[1].min_plane_buffer_height_multiple = 16;
-	pconstraint.plane_format[1].buffer_alignment = 256;
-
-	ret = hfi_session_set_property(inst, ptype, &pconstraint);
+	ret = venus_helper_set_format_constraints_for_type(inst, buffer_type, stride_multiple);
 	if (!ret && IS_IRIS1(inst->core))
 		dev_info(inst->core->dev_dec,
 			 "sm8150-venus: P010 constraints sent type=%#x planes=2 stride=%u heights=32/16 align=256\n",
-			 pconstraint.buffer_type, stride_multiple);
+			 inst->opb_buftype, stride_multiple);
 
 	return ret;
 }
 EXPORT_SYMBOL_GPL(venus_helper_set_format_constraints);
 
+int venus_helper_set_input_format_constraints(struct venus_inst *inst, u32 pixfmt)
+{
+	int ret;
+
+	if (!IS_IRIS1(inst->core) ||
+	    inst->session_type != VIDC_SESSION_TYPE_ENC ||
+	    pixfmt != V4L2_PIX_FMT_P010)
+		return 0;
+
+	ret = venus_helper_set_format_constraints_for_type(inst, HFI_BUFFER_INPUT, 256);
+	if (!ret)
+		dev_info(inst->core->dev,
+			 "venus-migrate: encoder P010 constraints type=%#x stride=256 heights=32/16\n",
+			 HFI_BUFFER_INPUT);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(venus_helper_set_input_format_constraints);
+
 int venus_helper_set_num_bufs(struct venus_inst *inst, unsigned int input_bufs,
 			      unsigned int output_bufs,
 			      unsigned int output2_bufs)
@@ -2245,6 +2275,14 @@ bool venus_helper_check_format(struct venus_inst *inst, u32 v4l2_pixfmt)
 	if (!caps)
 		return false;
 
+	if (inst->session_type == VIDC_SESSION_TYPE_ENC) {
+		found = find_fmt_from_caps(caps, HFI_BUFFER_INPUT, fmt);
+		/* SM8150 downstream exposes NV21 although the static HFI4 table omits it. */
+		if (!found && IS_IRIS1(core) && fmt == HFI_COLOR_FORMAT_NV21)
+			found = true;
+		return found;
+	}
+
 	found = find_fmt_from_caps(caps, HFI_BUFFER_OUTPUT, fmt);
 	if (found)
 		goto done;
diff --git a/drivers/media/platform/qcom/venus/helpers.h b/drivers/media/platform/qcom/venus/helpers.h
index 62c5183e56badadd4679933afed78b46e9d1f2f5..1b766b1c8c572abb4c38b57a663e517ac7b8f89b 100644
--- a/drivers/media/platform/qcom/venus/helpers.h
+++ b/drivers/media/platform/qcom/venus/helpers.h
@@ -41,6 +41,7 @@ int venus_helper_set_output_resolution(struct venus_inst *inst,
 int venus_helper_set_work_mode(struct venus_inst *inst);
 int venus_helper_set_work_route(struct venus_inst *inst);
 int venus_helper_set_format_constraints(struct venus_inst *inst);
+int venus_helper_set_input_format_constraints(struct venus_inst *inst, u32 pixfmt);
 int venus_helper_set_num_bufs(struct venus_inst *inst, unsigned int input_bufs,
 			      unsigned int output_bufs,
 			      unsigned int output2_bufs);
diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index 97fb6bd5ec764231c9406efc839ed175ab083ed5..29571caaa563168edc69cb2ce44c651689169568 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -39,7 +39,7 @@ static bool venus_iris1_encoder_vendor_nv12 = true;
 module_param_named(iris1_encoder_vendor_nv12,
 		   venus_iris1_encoder_vendor_nv12, bool, 0644);
 MODULE_PARM_DESC(iris1_encoder_vendor_nv12,
-		 "Use the SM8150 downstream NV12 allocation formula (default: on)");
+		 "Use SM8150 downstream raw-input allocation formulas (default: on)");
 
 static bool venus_iris1_encoder_bidirectional = true;
 module_param_named(iris1_encoder_bidirectional,
@@ -60,6 +60,26 @@ static const struct venus_format venc_formats[] = {
 		.num_planes = 1,
 		.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE,
 	},
+	[VENUS_FMT_NV21] = {
+		.pixfmt = V4L2_PIX_FMT_NV21,
+		.num_planes = 1,
+		.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE,
+	},
+	[VENUS_FMT_QC08C] = {
+		.pixfmt = V4L2_PIX_FMT_QC08C,
+		.num_planes = 1,
+		.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE,
+	},
+	[VENUS_FMT_QC10C] = {
+		.pixfmt = V4L2_PIX_FMT_QC10C,
+		.num_planes = 1,
+		.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE,
+	},
+	[VENUS_FMT_P010] = {
+		.pixfmt = V4L2_PIX_FMT_P010,
+		.num_planes = 1,
+		.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE,
+	},
 	[VENUS_FMT_H264] = {
 		.pixfmt = V4L2_PIX_FMT_H264,
 		.num_planes = 1,
@@ -105,6 +125,9 @@ find_format(struct venus_inst *inst, u32 pixfmt, u32 type)
 	if (type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
 	    !venus_helper_check_codec(inst, fmt[i].pixfmt))
 		return NULL;
+	if (type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE &&
+	    !venus_helper_check_format(inst, fmt[i].pixfmt))
+		return NULL;
 
 	return &fmt[i];
 }
@@ -124,8 +147,10 @@ find_format_by_index(struct venus_inst *inst, unsigned int index, u32 type)
 
 		if (fmt[i].type != type)
 			continue;
-		valid = type != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE ||
-			venus_helper_check_codec(inst, fmt[i].pixfmt);
+		if (type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
+			valid = venus_helper_check_codec(inst, fmt[i].pixfmt);
+		else
+			valid = venus_helper_check_format(inst, fmt[i].pixfmt);
 		if (k == index && valid)
 			break;
 		if (valid)
@@ -199,22 +224,81 @@ static u32 venc_get_framesz(struct venus_inst *inst, u32 pixfmt,
 			    u32 width, u32 height)
 {
 	u32 y_stride, uv_stride, y_scanlines, uv_scanlines;
+	u32 y_meta_stride, y_meta_scanlines, y_meta_plane;
+	u32 uv_meta_stride, uv_meta_scanlines, uv_meta_plane;
+	u32 y_plane, uv_plane, half_height;
 
 	if (!IS_IRIS1(inst->core) ||
-	    !inst->enc_vendor_nv12 ||
-	    pixfmt != V4L2_PIX_FMT_NV12)
+	    !inst->enc_vendor_nv12)
+		return venus_helper_get_framesz(pixfmt, width, height);
+
+	switch (pixfmt) {
+	case V4L2_PIX_FMT_NV12:
+	case V4L2_PIX_FMT_NV21:
+		y_stride = ALIGN(width, 128);
+		uv_stride = ALIGN(width, 128);
+		break;
+	case V4L2_PIX_FMT_P010:
+		y_stride = ALIGN(width * 2, 256);
+		uv_stride = ALIGN(width * 2, 256);
+		break;
+	case V4L2_PIX_FMT_QC08C:
+		y_stride = ALIGN(width, 128);
+		uv_stride = ALIGN(width, 128);
+		half_height = (height + 1) >> 1;
+		y_scanlines = ALIGN(half_height, 32);
+		uv_scanlines = ALIGN((half_height + 1) >> 1, 32);
+		y_plane = ALIGN(y_stride * y_scanlines, SZ_4K);
+		uv_plane = ALIGN(uv_stride * uv_scanlines, SZ_4K);
+		y_meta_stride = ALIGN(DIV_ROUND_UP(width, 32), 64);
+		y_meta_scanlines = ALIGN(DIV_ROUND_UP(half_height, 8), 16);
+		y_meta_plane = ALIGN(y_meta_stride * y_meta_scanlines, SZ_4K);
+		uv_meta_stride = ALIGN(DIV_ROUND_UP((width + 1) >> 1, 16), 64);
+		uv_meta_scanlines = ALIGN(DIV_ROUND_UP((half_height + 1) >> 1, 8), 16);
+		uv_meta_plane = ALIGN(uv_meta_stride * uv_meta_scanlines, SZ_4K);
+
+		return ALIGN((y_plane + uv_plane + y_meta_plane +
+			      uv_meta_plane) * 2, SZ_4K);
+	case V4L2_PIX_FMT_QC10C:
+		y_stride = ALIGN(roundup(width, 192) * 4 / 3, 256);
+		uv_stride = y_stride;
+		y_scanlines = ALIGN(height, 16);
+		uv_scanlines = ALIGN((height + 1) >> 1, 16);
+		y_plane = ALIGN(y_stride * y_scanlines, SZ_4K);
+		uv_plane = ALIGN(uv_stride * uv_scanlines, SZ_4K);
+		y_meta_stride = ALIGN(DIV_ROUND_UP(width, 48), 64);
+		y_meta_scanlines = ALIGN(DIV_ROUND_UP(height, 4), 16);
+		y_meta_plane = ALIGN(y_meta_stride * y_meta_scanlines, SZ_4K);
+		uv_meta_stride = ALIGN(DIV_ROUND_UP((width + 1) >> 1, 24), 64);
+		uv_meta_scanlines = ALIGN(DIV_ROUND_UP((height + 1) >> 1, 4), 16);
+		uv_meta_plane = ALIGN(uv_meta_stride * uv_meta_scanlines, SZ_4K);
+
+		return ALIGN(y_plane + uv_plane + y_meta_plane + uv_meta_plane,
+			     SZ_4K);
+	default:
 		return venus_helper_get_framesz(pixfmt, width, height);
+	}
 
-	y_stride = ALIGN(width, 128);
-	uv_stride = ALIGN(width, 128);
 	y_scanlines = ALIGN(height, 32);
 	uv_scanlines = ALIGN((height + 1) >> 1, 16);
 
-	/* Exact COLOR_FMT_NV12 VENUS_BUFFER_SIZE() from SM8150 Q OSS. */
+	/* Exact linear VENUS_BUFFER_SIZE() from the SM8150 Q OSS driver. */
 	return ALIGN(y_stride * y_scanlines + uv_stride * uv_scanlines + SZ_4K,
 		     SZ_4K);
 }
 
+static u32 venc_get_stride(u32 pixfmt, u32 width)
+{
+	switch (pixfmt) {
+	case V4L2_PIX_FMT_P010:
+		return ALIGN(width * 2, 256);
+	case V4L2_PIX_FMT_QC10C:
+		return ALIGN(roundup(width, 192) * 4 / 3, 256);
+	default:
+		return ALIGN(width, 128);
+	}
+}
+
 static const struct venus_format *
 venc_try_fmt_common(struct venus_inst *inst, struct v4l2_format *f)
 {
@@ -260,7 +344,7 @@ venc_try_fmt_common(struct venus_inst *inst, struct v4l2_format *f)
 	pfmt[0].sizeimage = max(ALIGN(pfmt[0].sizeimage, SZ_4K), sizeimage);
 
 	if (f->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
-		pfmt[0].bytesperline = ALIGN(pixmp->width, 128);
+		pfmt[0].bytesperline = venc_get_stride(pixmp->pixelformat, pixmp->width);
 	else
 		pfmt[0].bytesperline = 0;
 
@@ -333,10 +417,16 @@ static int venc_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
 	inst->width = format.fmt.pix_mp.width;
 	inst->height = format.fmt.pix_mp.height;
 
-	if (f->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+	if (f->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE) {
 		inst->fmt_out = fmt;
-	else if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+		if (fmt->pixfmt == V4L2_PIX_FMT_P010 ||
+		    fmt->pixfmt == V4L2_PIX_FMT_QC10C)
+			inst->bit_depth = VIDC_BITDEPTH_10;
+		else
+			inst->bit_depth = VIDC_BITDEPTH_8;
+	} else if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
 		inst->fmt_cap = fmt;
+		inst->hfi_codec = venus_helper_get_codec(fmt->pixfmt);
 		inst->output_buf_size = pixmp->plane_fmt[0].sizeimage;
 	}
 
@@ -1184,6 +1274,10 @@ static int venc_init_session(struct venus_inst *inst)
 	if (ret)
 		goto deinit;
 
+	ret = venus_helper_set_input_format_constraints(inst, inst->fmt_out->pixfmt);
+	if (ret)
+		goto deinit;
+
 	/* VPU5 applies its encoder properties once, at final STREAMON. */
 	if (!IS_IRIS1(inst->core)) {
 		ret = venc_set_properties(inst, true);
@@ -1444,7 +1538,8 @@ static int venc_iris1_preflight(struct venus_inst *inst)
 		return -EIO;
 	}
 
-	if (!inst->fmt_out || inst->fmt_out->pixfmt != V4L2_PIX_FMT_NV12 ||
+	if (!inst->fmt_out ||
+	    !venus_helper_check_format(inst, inst->fmt_out->pixfmt) ||
 	    !inst->input_buf_size || !inst->output_buf_size || !inst->fps) {
 		dev_err(core->dev,
 			"venus-test10: refusing invalid encoder configuration\n");

