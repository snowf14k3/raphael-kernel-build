From: Codex <codex@openai.com>
Date: Tue, 8 Sep 2026 20:00:00 +0800
Subject: [PATCH 23/28] media: venus: support SM8150 Main10 split output

The SM8150 downstream decoder does not require a 10-bit client capture
format for a 10-bit stream.  It can retain its reference frames in TP10
UBWC and expose a secondary NV12 output, which is important for clients
whose V4L2 format table cannot import P010.  Keep that split-output mode
available on IRIS1 while preserving native P010 selection for clients
which support it.

Validate the exact TP10/NV12 HFI format pair before starting the session,
retain an explicitly selected NV12 format across source change, and reject
firmware payloads which exceed the queued capture plane.  Also correct the
P010 layout comment: the downstream formula adds tail padding rather than
an inter-plane gap.

This follows the Xiaomi SM8150 HFI4 split-output policy.  Newer Iris HFI6
drivers intentionally use a different native-bit-depth userspace ABI and
are left unchanged.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/media/platform/qcom/venus/vdec.c | 67 ++++++++++++++++++++++--
 1 file changed, 57 insertions(+), 10 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 292e057cf898..6fe3b3144911 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -125,12 +125,31 @@ static bool vdec_fmt_is_10bit(u32 pixfmt)
 	       pixfmt == V4L2_PIX_FMT_QC10C;
 }
 
+static bool vdec_capture_fmt_matches_stream(struct venus_inst *inst,
+					    u32 pixfmt)
+{
+	/*
+	 * SM8150 firmware can keep 10-bit reference frames in TP10 UBWC while
+	 * writing an NV12 secondary output for clients which cannot import
+	 * P010.  This is the downstream driver's normal split-output path, not
+	 * an incorrectly labelled 10-bit buffer.
+	 */
+	if (IS_IRIS1(inst->core) && inst->bit_depth == VIDC_BITDEPTH_10 &&
+	    pixfmt == V4L2_PIX_FMT_NV12)
+		return true;
+
+	if (inst->bit_depth == VIDC_BITDEPTH_10)
+		return vdec_fmt_is_10bit(pixfmt);
+
+	return vdec_fmt_is_8bit(pixfmt);
+}
+
 static u32 vdec_get_framesz(struct venus_inst *inst, u32 pixfmt,
 			    u32 width, u32 height)
 {
 	u32 size = venus_helper_get_framesz(pixfmt, width, height);
 
-	/* SM8150 downstream VENUS_BUFFER_SIZE reserves a 4 KiB UV gap. */
+	/* SM8150 downstream VENUS_BUFFER_SIZE adds 4 KiB tail padding. */
 	if (IS_IRIS1(inst->core) && pixfmt == V4L2_PIX_FMT_P010 && size)
 		size += SZ_4K;
 
@@ -170,12 +189,7 @@ static bool vdec_format_is_valid(struct venus_inst *inst,
 	if (!match_bit_depth || !V4L2_TYPE_IS_CAPTURE(type))
 		return true;
 
-	if (vdec_fmt_is_8bit(fmt->pixfmt) &&
-	    inst->bit_depth == VIDC_BITDEPTH_10)
-		return false;
-
-	if (vdec_fmt_is_10bit(fmt->pixfmt) &&
-	    inst->bit_depth != VIDC_BITDEPTH_10)
+	if (!vdec_capture_fmt_matches_stream(inst, fmt->pixfmt))
 		return false;
 
 	return true;
@@ -878,6 +892,19 @@ static int vdec_output_conf(struct venus_inst *inst)
 	if (ret)
 		return ret;
 
+	if (IS_IRIS1(core) && inst->bit_depth == VIDC_BITDEPTH_10 &&
+	    inst->fmt_cap->pixfmt == V4L2_PIX_FMT_NV12) {
+		if (out_fmt != HFI_COLOR_FORMAT_YUV420_TP10_UBWC ||
+		    out2_fmt != HFI_COLOR_FORMAT_NV12) {
+			dev_err(core->dev_dec,
+				"10-bit NV12 output requires TP10 DPB split mode\n");
+			return -EINVAL;
+		}
+
+		dev_info(core->dev_dec,
+			 "venus-migrate: 10-bit stream uses TP10 DPB and NV12 client output\n");
+	}
+
 	inst->output_buf_size = vdec_get_framesz_raw(inst, out_fmt, width, height);
 	inst->output2_buf_size = vdec_get_framesz_raw(inst, out2_fmt, width,
 						     height);
@@ -1572,12 +1599,23 @@ static void vdec_buf_done(struct venus_inst *inst, unsigned int buf_type,
 	vb = &vbuf->vb2_buf;
 
 	if (type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+		unsigned long length = vb2_plane_size(vb, 0);
+
 		if (IS_IRIS1(inst->core) && !inst->sequence_cap)
 			dev_info(inst->core->dev_dec,
 				 "venus-test8: first capture buffer type=%#x tag=%u bytes=%u offset=%u fmt=%#x hfi_flags=%#x\n",
 				 buf_type, tag, bytesused, data_offset,
 				 inst->fmt_cap->pixfmt, hfi_flags);
 
+		if (data_offset > length || bytesused > length - data_offset) {
+			dev_err(inst->core->dev_dec,
+				"capture payload outside buffer: offset=%u bytes=%u length=%lu\n",
+				data_offset, bytesused, length);
+			data_offset = 0;
+			bytesused = 0;
+			state = VB2_BUF_STATE_ERROR;
+		}
+
 		vb2_set_plane_payload(vb, 0, bytesused);
 		vb->planes[0].data_offset = data_offset;
 		vb->timestamp = timestamp_us * NSEC_PER_USEC;
@@ -1630,10 +1668,19 @@ static void vdec_event_change(struct venus_inst *inst,
 
 	if (inst->bit_depth != ev_data->bit_depth) {
 		inst->bit_depth = ev_data->bit_depth;
-		if (inst->bit_depth == VIDC_BITDEPTH_10)
-			inst->fmt_cap = &vdec_formats[VENUS_FMT_P010];
-		else
+		if (inst->bit_depth == VIDC_BITDEPTH_10) {
+			/*
+			 * Keep NV12 on IRIS1 when the client selected it.  The firmware
+			 * then performs the same TP10-DPB to NV12-OPB conversion used by
+			 * the downstream SM8150 driver.  P010 remains selectable after
+			 * the source-change event for clients which support it.
+			 */
+			if (!IS_IRIS1(inst->core) ||
+			    inst->fmt_cap->pixfmt != V4L2_PIX_FMT_NV12)
+				inst->fmt_cap = &vdec_formats[VENUS_FMT_P010];
+		} else {
 			inst->fmt_cap = &vdec_formats[VENUS_FMT_NV12];
+		}
 	}
 
 	format.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
-- 
2.51.0.windows.1
