+static void dpu_encoder_phys_cmd_diag_log(struct dpu_encoder_phys *phys_enc,
+					  const char *reason)
+{
+	struct dpu_encoder_phys_cmd *cmd_enc = to_dpu_encoder_phys_cmd(phys_enc);
+	struct dpu_hw_intf_status intf_status = {};
+	u64 core_clk = 0, max_core_clk = 0;
+	u32 pp_line = 0, pending_flush = 0;
+	bool ctl_started = false;
+	int event;
+
+	if (!phys_enc)
+		return;
+
+	event = atomic_inc_return(&dpu_cmd_diag_seq);
+
+	if (phys_enc->hw_intf && phys_enc->hw_intf->ops.get_status)
+		phys_enc->hw_intf->ops.get_status(phys_enc->hw_intf, &intf_status);
+	if (phys_enc->hw_pp && phys_enc->hw_pp->ops.get_line_count)
+		pp_line = phys_enc->hw_pp->ops.get_line_count(phys_enc->hw_pp);
+	if (phys_enc->hw_ctl) {
+		if (phys_enc->hw_ctl->ops.is_started)
+			ctl_started = phys_enc->hw_ctl->ops.is_started(phys_enc->hw_ctl);
+		if (phys_enc->hw_ctl->ops.get_pending_flush)
+			pending_flush = phys_enc->hw_ctl->ops.get_pending_flush(phys_enc->hw_ctl);
+	}
+	if (phys_enc->dpu_kms) {
+		core_clk = phys_enc->dpu_kms->perf.core_clk_rate;
+		max_core_clk = phys_enc->dpu_kms->perf.max_core_clk_rate;
+	}
+
+	DPU_ERROR_CMDENC_RATELIMITED(cmd_enc,
+		"DPUCMD#%d reason=%s state=%d split=%d master=%u stream=%d serial_wait=%u te=%u kickoff=%d ctlstart=%d vblank=%d vsync=%d underrun=%d pp_timeout=%d mode=%dx%d clock=%d\n",
+		event, reason, phys_enc->enable_state, phys_enc->split_role,
+		dpu_encoder_phys_cmd_is_master(phys_enc), cmd_enc->stream_sel,
+		cmd_enc->serialize_wait4pp, phys_enc->has_intf_te,
+		atomic_read(&phys_enc->pending_kickoff_cnt),
+		atomic_read(&phys_enc->pending_ctlstart_cnt),
+		atomic_read(&cmd_enc->pending_vblank_cnt),
+		atomic_read(&phys_enc->vsync_cnt),
+		atomic_read(&phys_enc->underrun_cnt), cmd_enc->pp_timeout_report_cnt,
+		phys_enc->cached_mode.hdisplay, phys_enc->cached_mode.vdisplay,
+		phys_enc->cached_mode.clock);
+
+	DPU_ERROR_CMDENC_RATELIMITED(cmd_enc,
+		"DPUCMD#%d hw: intf_en=%u prog_fetch=%u intf_frame=%u intf_line=%u pp_line=%u ctl_started=%u pending_flush=%08x irq_pp=%u irq_underrun=%u irq_ctl=%u irq_rdptr=%u perf_core=%llu/%llu\n",
+		event, intf_status.is_en, intf_status.is_prog_fetch_en,
+		intf_status.frame_count, intf_status.line_count, pp_line,
+		ctl_started, pending_flush, phys_enc->irq[INTR_IDX_PINGPONG],
+		phys_enc->irq[INTR_IDX_UNDERRUN], phys_enc->irq[INTR_IDX_CTL_START],
+		phys_enc->irq[INTR_IDX_RDPTR], core_clk, max_core_clk);
+}
