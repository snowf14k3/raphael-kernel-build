+int venus_helper_set_work_route(struct venus_inst *inst)
+{
+	const u32 ptype = HFI_PROPERTY_PARAM_WORK_ROUTE;
+	struct hfi_video_work_route wr = { .video_work_route = 2 };
+	struct venc_controls *ctr = &inst->controls.enc;
+	bool low_cbr, max_bytes;
+	u32 mbs_per_sec;
+	int ret;
+
+	if (!IS_IRIS1(inst->core))
+		return 0;
+
+	if (inst->session_type == VIDC_SESSION_TYPE_DEC) {
+		if (inst->hfi_codec == HFI_VIDEO_CODEC_MPEG2 ||
+		    (inst->hfi_codec == HFI_VIDEO_CODEC_H264 &&
+		     inst->pic_struct != HFI_INTERLACE_FRAME_PROGRESSIVE))
+			wr.video_work_route = 1;
+	} else if (inst->session_type == VIDC_SESSION_TYPE_ENC) {
+		mbs_per_sec = (ALIGN(inst->out_width, 16) / 16) *
+			      (ALIGN(inst->out_height, 16) / 16) * inst->fps;
+		max_bytes = ctr->multi_slice_mode ==
+			    V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_MAX_BYTES;
+		low_cbr = ctr->bitrate_mode == V4L2_MPEG_VIDEO_BITRATE_MODE_CBR &&
+			  mbs_per_sec <= CBR_MBS_720P_30;
+
+		if (inst->hfi_codec == HFI_VIDEO_CODEC_VP8 ||
+		    (ctr->bitrate_mode != V4L2_MPEG_VIDEO_BITRATE_MODE_CQ &&
+		     (max_bytes || low_cbr)))
+			wr.video_work_route = 1;
+	} else {
+		return -EINVAL;
+	}
+
+	wr.video_work_route = min_t(u32, wr.video_work_route,
+				    inst->core->res->num_vpp_pipes);
+	if (!wr.video_work_route)
+		return -EINVAL;
+
+	ret = hfi_session_set_property(inst, ptype, &wr);
+	if (ret)
+		return ret;
+
+	inst->clk_data.work_route = wr.video_work_route;
+	dev_info(inst->core->dev, "venus-test6: session type=%u work route=%u\n",
+		 inst->session_type, wr.video_work_route);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(venus_helper_set_work_route);
