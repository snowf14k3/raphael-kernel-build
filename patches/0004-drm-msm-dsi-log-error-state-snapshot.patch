@@ -1721,7 +1843,7 @@ static irqreturn_t dsi_host_irq(int irq, void *ptr)
 	DBG("isr=0x%x, id=%d", isr, msm_host->id);
 
 	if (isr & DSI_IRQ_ERROR)
-		dsi_error(msm_host);
+		dsi_error(msm_host, isr);
 
 	if (isr & DSI_IRQ_VIDEO_DONE)
 		complete(&msm_host->video_comp);
