+static void dsi_log_error_snapshot(struct msm_dsi_host *msm_host, u32 isr)
+{
+	u32 ctrl = dsi_read(msm_host, REG_DSI_CTRL);
+	u32 status0 = dsi_read(msm_host, REG_DSI_STATUS0);
+	u32 fifo = dsi_read(msm_host, REG_DSI_FIFO_STATUS);
+	u32 ack = dsi_read(msm_host, REG_DSI_ACK_ERR_STATUS);
+	u32 timeout = dsi_read(msm_host, REG_DSI_TIMEOUT_STATUS);
+	u32 phy = dsi_read(msm_host, REG_DSI_DLN0_PHY_ERR);
+	u32 clk = dsi_read(msm_host, REG_DSI_CLK_STATUS);
+	u32 lane = dsi_read(msm_host, REG_DSI_LANE_STATUS);
+	u32 lane_ctrl = dsi_read(msm_host, REG_DSI_LANE_CTRL);
+	u32 trig = dsi_read(msm_host, REG_DSI_TRIG_CTRL);
+	u32 cmd_dma = dsi_read(msm_host, REG_DSI_CMD_DMA_CTRL);
+	u32 dma_base = dsi_read(msm_host, REG_DSI_DMA_BASE);
+	u32 dma_len = dsi_read(msm_host, REG_DSI_DMA_LEN);
+	u32 stream0 = dsi_read(msm_host, REG_DSI_CMD_MDP_STREAM0_CTRL);
+	u32 stream0_total = dsi_read(msm_host, REG_DSI_CMD_MDP_STREAM0_TOTAL);
+	u32 stream1 = dsi_read(msm_host, REG_DSI_CMD_MDP_STREAM1_CTRL);
+	u32 stream1_total = dsi_read(msm_host, REG_DSI_CMD_MDP_STREAM1_TOTAL);
+	u32 mdp2 = 0;
+	u32 stream2 = 0;
+	u32 hs_timer = dsi_read(msm_host, REG_DSI_HS_TIMER_CTRL);
+	u32 lp_timer = dsi_read(msm_host, REG_DSI_LP_TIMER_CTRL);
+	u32 eot = dsi_read(msm_host, REG_DSI_EOT_PACKET_CTRL);
+	u32 clk_ctrl = dsi_read(msm_host, REG_DSI_CLK_CTRL);
+	u32 err_mask = dsi_read(msm_host, REG_DSI_ERR_INT_MASK0);
+	u32 vid_cfg0 = dsi_read(msm_host, REG_DSI_VID_CFG0);
+	u32 vid_cfg1 = dsi_read(msm_host, REG_DSI_VID_CFG1);
+	u32 cmd_cfg0 = dsi_read(msm_host, REG_DSI_CMD_CFG0);
+	u32 cmd_cfg1 = dsi_read(msm_host, REG_DSI_CMD_CFG1);
+	int hdisplay = 0, vdisplay = 0, mode_clock = 0;
+
+	if (msm_host->cfg_hnd && msm_host->cfg_hnd->major == MSM_DSI_VER_MAJOR_6G) {
+		mdp2 = dsi_read(msm_host, REG_DSI_CMD_MODE_MDP_CTRL2);
+		stream2 = dsi_read(msm_host, REG_DSI_CMD_MODE_MDP_STREAM2_CTRL);
+	}
+
+	if (msm_host->mode) {
+		hdisplay = msm_host->mode->hdisplay;
+		vdisplay = msm_host->mode->vdisplay;
+		mode_clock = msm_host->mode->clock;
+	}
+
+	pr_err_ratelimited(
+		"dsi%d raw err: isr=%08x ctrl=%08x status0=%08x fifo=%08x ack=%08x timeout=%08x phy=%08x clk=%08x lane=%08x lane_ctrl=%08x\n",
+		msm_host->id, isr, ctrl, status0, fifo, ack, timeout, phy,
+		clk, lane, lane_ctrl);
+
+	pr_err_ratelimited(
+		"dsi%d raw cmd: trig=%08x cmd_dma=%08x dma_base=%08x dma_len=%08x s0=%08x/%08x s1=%08x/%08x mdp2=%08x s2=%08x\n",
+		msm_host->id, trig, cmd_dma, dma_base, dma_len, stream0,
+		stream0_total, stream1, stream1_total, mdp2, stream2);
+
+	pr_err_ratelimited(
+		"dsi%d raw timing: hs_timer=%08x lp_timer=%08x eot=%08x clk_ctrl=%08x err_mask=%08x vid_cfg=%08x/%08x cmd_cfg=%08x/%08x\n",
+		msm_host->id, hs_timer, lp_timer, eot, clk_ctrl, err_mask,
+		vid_cfg0, vid_cfg1, cmd_cfg0, cmd_cfg1);
+
+	pr_err_ratelimited(
+		"dsi%d fifo bits: vid_ovf=%u vid_udf=%u cmd_mdp_udf=%u cmd_dma_rdwm=%u cmd_dma_wrwm=%u cmd_dma_udf=%u lp_empty=%u lp_full=%u lp_ovf=%u hs_udf=%u/%u/%u/%u hs_ovf=%u/%u/%u/%u\n",
+		msm_host->id,
+		!!(fifo & DSI_FIFO_STATUS_VIDEO_MDP_FIFO_OVERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_VIDEO_MDP_FIFO_UNDERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_CMD_MDP_FIFO_UNDERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_CMD_DMA_FIFO_RD_WATERMARK_REACH),
+		!!(fifo & DSI_FIFO_STATUS_CMD_DMA_FIFO_WR_WATERMARK_REACH),
+		!!(fifo & DSI_FIFO_STATUS_CMD_DMA_FIFO_UNDERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN0_LP_FIFO_EMPTY),
+		!!(fifo & DSI_FIFO_STATUS_DLN0_LP_FIFO_FULL),
+		!!(fifo & DSI_FIFO_STATUS_DLN0_LP_FIFO_OVERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN0_HS_FIFO_UNDERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN1_HS_FIFO_UNDERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN2_HS_FIFO_UNDERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN3_HS_FIFO_UNDERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN0_HS_FIFO_OVERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN1_HS_FIFO_OVERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN2_HS_FIFO_OVERFLOW),
+		!!(fifo & DSI_FIFO_STATUS_DLN3_HS_FIFO_OVERFLOW));
+
+	pr_err_ratelimited(
+		"dsi%d busy bits: engine=%u dma=%u mdp=%u video=%u dsi=%u contention=%u lanes=%u fmt=%u flags=%#lx power=%u enabled=%u mode=%dx%d clock=%d rates=%lu/%lu/%lu/%lu\n",
+		msm_host->id,
+		!!(status0 & DSI_STATUS0_CMD_MODE_ENGINE_BUSY),
+		!!(status0 & DSI_STATUS0_CMD_MODE_DMA_BUSY),
+		!!(status0 & DSI_STATUS0_CMD_MODE_MDP_BUSY),
+		!!(status0 & DSI_STATUS0_VIDEO_MODE_ENGINE_BUSY),
+		!!(status0 & DSI_STATUS0_DSI_BUSY),
+		!!(status0 & DSI_STATUS0_INTERLEAVE_OP_CONTENTION),
+		msm_host->lanes, msm_host->format, msm_host->mode_flags,
+		msm_host->power_on, msm_host->enabled, hdisplay, vdisplay, mode_clock,
+		msm_host->byte_clk_rate, msm_host->byte_intf_clk_rate,
+		msm_host->pixel_clk_rate, msm_host->esc_clk_rate);
+}
+
 static void dsi_status(struct msm_dsi_host *msm_host)
 {
 	u32 status;
@@ -1689,8 +1808,11 @@ static void dsi_clk_status(struct msm_dsi_host *msm_host)
 	}
 }
 
