+static void iris1_llcc_disable(struct venus_core *core)
+{
+	int i, ret;
+
+	for (i = VIDC_IRIS1_LLCC_NUM - 1; i >= 0; i--) {
+		if (!(core->iris1_llcc_mask & BIT(i)))
+			continue;
+
+		ret = llcc_slice_deactivate(core->iris1_llcc[i]);
+		if (ret) {
+			dev_warn(core->dev,
+				 "failed to deactivate video LLCC slice %d: %d\n",
+				 i, ret);
+			continue;
+		}
+		core->iris1_llcc_mask &= ~BIT(i);
+	}
+}
+
+static int iris1_llcc_enable(struct venus_core *core)
+{
+	int i, ret;
+
+	for (i = 0; i < VIDC_IRIS1_LLCC_NUM; i++) {
+		if (core->iris1_llcc_mask & BIT(i))
+			continue;
+
+		ret = llcc_slice_activate(core->iris1_llcc[i]);
+		if (ret) {
+			iris1_llcc_disable(core);
+			return ret;
+		}
+		core->iris1_llcc_mask |= BIT(i);
+	}
+
+	return 0;
+}
+
+static void iris1_llcc_put(struct venus_core *core)
+{
+	int i;
+
+	iris1_llcc_disable(core);
+
+	for (i = VIDC_IRIS1_LLCC_NUM - 1; i >= 0; i--) {
+		llcc_slice_putd(core->iris1_llcc[i]);
+		core->iris1_llcc[i] = NULL;
+	}
+}
+
+static int core_get_iris1(struct venus_core *core)
+{
+	static const u32 llcc_uids[VIDC_IRIS1_LLCC_NUM] = {
+		LLCC_VIDSC0, LLCC_VIDSC1,
+	};
+	int i, ret;
+
+	ret = core_get_v4(core);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < VIDC_IRIS1_LLCC_NUM; i++) {
+		core->iris1_llcc[i] = llcc_slice_getd(llcc_uids[i]);
+		if (IS_ERR_OR_NULL(core->iris1_llcc[i])) {
+			ret = core->iris1_llcc[i] ?
+				PTR_ERR(core->iris1_llcc[i]) : -ENODEV;
+			core->iris1_llcc[i] = NULL;
+			goto err_llcc;
+		}
+	}
+
+	dev_info(core->dev,
+		 "venus-test9: found VIDSC0 id=%d size=%zu KiB, VIDSC1 id=%d size=%zu KiB\n",
+		 llcc_get_slice_id(core->iris1_llcc[0]),
+		 llcc_get_slice_size(core->iris1_llcc[0]),
+		 llcc_get_slice_id(core->iris1_llcc[1]),
+		 llcc_get_slice_size(core->iris1_llcc[1]));
+
+	return 0;
+
+err_llcc:
+	iris1_llcc_put(core);
+	return dev_err_probe(core->dev, ret,
+			     "failed to acquire SM8150 video system cache\n");
+}
+
