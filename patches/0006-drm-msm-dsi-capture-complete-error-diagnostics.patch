+static void dsi_diag_log_xfer_history(struct msm_dsi_host *msm_host,
+				      u32 event, u64 now_ns)
+{
+	struct dsi_diag_xfer history[DSI_DIAG_XFER_HISTORY];
+	unsigned long flags;
+	u32 head;
+	int i;
+
+	spin_lock_irqsave(&msm_host->diag_lock, flags);
+	head = msm_host->diag_xfer_head;
+	memcpy(history, msm_host->diag_xfer, sizeof(history));
+	spin_unlock_irqrestore(&msm_host->diag_lock, flags);
+
+	for (i = 0; i < DSI_DIAG_XFER_HISTORY; i++) {
+		const struct dsi_diag_xfer *x;
+		u32 idx = (head - 1 - i) & (DSI_DIAG_XFER_HISTORY - 1);
+		u64 age_us, wait_us = 0, dur_us = 0;
+		u32 dump_len;
+
+		x = &history[idx];
+		if (!x->seq)
+			continue;
+
+		age_us = now_ns > x->queued_ns ? (now_ns - x->queued_ns) / 1000 : 0;
+		if (x->start_ns > x->queued_ns)
+			wait_us = (x->start_ns - x->queued_ns) / 1000;
+		if (x->start_ns) {
+			u64 end_ns = x->end_ns ? x->end_ns : now_ns;
+
+			if (end_ns > x->start_ns)
+				dur_us = (end_ns - x->start_ns) / 1000;
+		}
+
+		dump_len = min_t(u32, x->tx_len, DSI_DIAG_TX_BYTES);
+		if (dump_len)
+			pr_err_ratelimited(
+				"DSIERR#%u dsi%d xfer[-%d] seq=%llu age_us=%llu wait_us=%llu dur_us=%llu ch=%u type=0x%02x flags=0x%04x tx_len=%u rx_len=%u ret=%d tx=%*ph\n",
+				event, msm_host->id, i, x->seq, age_us, wait_us,
+				dur_us, x->channel, x->type, x->flags, x->tx_len,
+				x->rx_len, x->result, dump_len, x->tx);
+		else
+			pr_err_ratelimited(
+				"DSIERR#%u dsi%d xfer[-%d] seq=%llu age_us=%llu wait_us=%llu dur_us=%llu ch=%u type=0x%02x flags=0x%04x tx_len=%u rx_len=%u ret=%d\n",
+				event, msm_host->id, i, x->seq, age_us, wait_us,
+				dur_us, x->channel, x->type, x->flags, x->tx_len,
+				x->rx_len, x->result);
+	}
+}
