+static u32 dsi_diag_record_xfer_begin(struct msm_dsi_host *msm_host,
+				      const struct mipi_dsi_msg *msg,
+				      u64 queued_ns, u64 start_ns)
+{
+	struct dsi_diag_xfer *x;
+	unsigned long flags;
+	u32 idx, copy_len;
+
+	spin_lock_irqsave(&msm_host->diag_lock, flags);
+	idx = msm_host->diag_xfer_head++ & (DSI_DIAG_XFER_HISTORY - 1);
+	x = &msm_host->diag_xfer[idx];
+	memset(x, 0, sizeof(*x));
+	x->seq = ++msm_host->diag_xfer_seq;
+	x->queued_ns = queued_ns;
+	x->start_ns = start_ns;
+	x->channel = msg->channel;
+	x->type = msg->type;
+	x->flags = msg->flags;
+	x->tx_len = min_t(size_t, msg->tx_len, U32_MAX);
+	x->rx_len = min_t(size_t, msg->rx_len, U32_MAX);
+	x->result = -EINPROGRESS;
+	copy_len = min_t(size_t, msg->tx_len, DSI_DIAG_TX_BYTES);
+	if (copy_len && msg->tx_buf)
+		memcpy(x->tx, msg->tx_buf, copy_len);
+	spin_unlock_irqrestore(&msm_host->diag_lock, flags);
+
+	return idx;
+}
+
+static void dsi_diag_record_xfer_end(struct msm_dsi_host *msm_host,
+				    u32 idx, int ret)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&msm_host->diag_lock, flags);
+	msm_host->diag_xfer[idx].end_ns = ktime_get_mono_fast_ns();
+	msm_host->diag_xfer[idx].result = ret;
+	spin_unlock_irqrestore(&msm_host->diag_lock, flags);
+}
