From 8bf31eb162a97c3c9952ae4be36aa75a3f5632bc Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Wed, 9 Sep 2026 02:15:00 +0800
Subject: [PATCH 15/15] media: venus: match SM8150 RC-OFF work mode

The downstream SM8150 encoder selects work mode 1 for RC-OFF, CBR and
CQ sessions, and follows it with the low-latency property.  The common
Venus policy selected work mode 2 for every H.264 encoder, leaving the
RC-OFF test session in a mode combination not used by the downstream
driver.  Staged bring-up showed that configuration and START succeeded,
but the SoC reset immediately after the first encoder ETB.

Apply the downstream rate-control-dependent work-mode policy only to
IRIS1.  Zero the reserved final word in the encoder ETB packet and log
the command-queue return so any remaining reset can be distinguished
from packet submission failure without another broad staged search.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 drivers/media/platform/qcom/venus/helpers.c  | 28 +++++++++++++++++++++++++++-
 drivers/media/platform/qcom/venus/hfi_cmds.c |  2 ++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -630,7 +630,15 @@ session_process_buf(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 			 fdata.clnt_data, fdata.device_addr, fdata.alloc_len,
 			 fdata.filled_len, fdata.offset);
 
-	return hfi_session_process_buf(inst, &fdata);
+	ret = hfi_session_process_buf(inst, &fdata);
+	if (IS_IRIS1(inst->core) &&
+	    inst->session_type == VIDC_SESSION_TYPE_ENC)
+		dev_info(inst->core->dev,
+			 "venus-test14: queued %s tag=%u ret=%d\n",
+			 fdata.buffer_type == HFI_BUFFER_INPUT ? "ETB" : "FTB",
+			 fdata.clnt_data, ret);
+
+	return ret;
 }
 
 static bool is_dynamic_bufmode(struct venus_inst *inst)
@@ -1346,6 +1356,7 @@ EXPORT_SYMBOL_GPL(venus_helper_set_output_resolution);
 
 static u32 venus_helper_get_work_mode(struct venus_inst *inst)
 {
+	struct venc_controls *ctr = &inst->controls.enc;
 	u32 mode;
 	u32 num_mbs;
 
@@ -1358,6 +1369,16 @@ static u32 venus_helper_get_work_mode(struct venus_inst *inst)
 		    inst->pic_struct != HFI_INTERLACE_FRAME_PROGRESSIVE ||
 		    num_mbs <= NUM_MBS_720P)
 			mode = VIDC_WORK_MODE_1;
+	} else if (IS_IRIS1(inst->core)) {
+		/*
+		 * Downstream SM8150 selects mode 1 for RC_OFF/CBR/CQ and
+		 * mode 2 only for VBR-family encoder sessions.  Mode 1 also
+		 * requires the low-latency property sent by the caller.
+		 */
+		mode = VIDC_WORK_MODE_1;
+		if (ctr->rc_enable &&
+		    ctr->bitrate_mode == V4L2_MPEG_VIDEO_BITRATE_MODE_VBR)
+			mode = VIDC_WORK_MODE_2;
 	} else {
 		num_mbs = (ALIGN(inst->out_height, 16) * ALIGN(inst->out_width, 16)) / 256;
 		if (inst->hfi_codec == HFI_VIDEO_CODEC_VP8 &&
@@ -1382,6 +1403,13 @@ int venus_helper_set_work_mode(struct venus_inst *inst)
 	if (ret)
 		return ret;
 
+	if (IS_IRIS1(inst->core) && inst->session_type == VIDC_SESSION_TYPE_ENC)
+		dev_info(inst->core->dev,
+			 "venus-test14: encoder work mode=%u rc_enable=%u bitrate_mode=%u low_latency=%u\n",
+			 mode, inst->controls.enc.rc_enable,
+			 inst->controls.enc.bitrate_mode,
+			 mode == VIDC_WORK_MODE_1);
+
 	/* VPU5 requires low-latency mode whenever an encoder uses work mode 1. */
 	if (IS_IRIS1(inst->core) && inst->session_type == VIDC_SESSION_TYPE_ENC &&
 	    mode == VIDC_WORK_MODE_1) {
diff --git a/drivers/media/platform/qcom/venus/hfi_cmds.c b/drivers/media/platform/qcom/venus/hfi_cmds.c
--- a/drivers/media/platform/qcom/venus/hfi_cmds.c
+++ b/drivers/media/platform/qcom/venus/hfi_cmds.c
@@ -330,6 +330,8 @@ int pkt_session_etb_encoder(
 	pkt->input_tag = in_frame->clnt_data;
 	pkt->packet_buffer = in_frame->device_addr;
 	pkt->extradata_buffer = in_frame->extradata_addr;
+	/* The final VPU5 packet word is reserved for plane-extension data. */
+	pkt->data = 0;
 
 	return 0;
 }
