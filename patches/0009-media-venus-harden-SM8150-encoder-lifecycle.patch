 drivers/media/platform/qcom/venus/helpers.c   | 132 ++++++++-
 drivers/media/platform/qcom/venus/helpers.h   |   1 +
 drivers/media/platform/qcom/venus/hfi_cmds.c  |   9 +-
 .../media/platform/qcom/venus/hfi_helper.h    |   8 +
 drivers/media/platform/qcom/venus/hfi_msgs.c  |   2 +-
 drivers/media/platform/qcom/venus/venc.c      | 255 +++++++++++++++---
 .../media/platform/qcom/venus/venc_ctrls.c    |  13 +-
 8 files changed, 376 insertions(+), 51 deletions(-)

