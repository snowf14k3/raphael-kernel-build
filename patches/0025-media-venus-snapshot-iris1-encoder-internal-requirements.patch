 {
 	struct venus_core *core = inst->core;
 	struct device *dev = core->dev;
-	struct hfi_buffer_requirements bufreq;
 	struct hfi_buffer_desc bd;
 	struct intbuf *buf;
 	unsigned int i;
 	int ret;
 
-	ret = venus_helper_get_bufreq(inst, type, &bufreq);
-	if (ret)
-		return 0;
-
-	if (!bufreq.size)
