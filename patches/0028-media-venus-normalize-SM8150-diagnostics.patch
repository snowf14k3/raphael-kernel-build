From 77121d1fe823d7441b793b2a642a3c3d6129ba68 Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Wed, 9 Sep 2026 20:40:00 +0800
Subject: [PATCH] media: venus: normalize SM8150 diagnostics

Replace the temporary per-test diagnostic prefixes with a stable SM8150
prefix.  This keeps the field diagnostics used for firmware, queue, PM and
buffer-contract verification without tying product logs to bring-up builds.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 drivers/media/platform/qcom/venus/helpers.c   | 40 +++++++++----------
 drivers/media/platform/qcom/venus/hfi.c       |  4 +-
 drivers/media/platform/qcom/venus/hfi_msgs.c  |  2 +-
 drivers/media/platform/qcom/venus/hfi_venus.c | 20 +++++-----
 .../media/platform/qcom/venus/pm_helpers.c    |  6 +--
 drivers/media/platform/qcom/venus/vdec.c      | 24 +++++------
 drivers/media/platform/qcom/venus/venc.c      | 26 ++++++------
 .../media/platform/qcom/venus/venc_ctrls.c    |  2 +-
 8 files changed, 62 insertions(+), 62 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
index b4fa10962063..18ecd0cba059 100644
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -245,7 +245,7 @@ static int intbufs_set_buffer(struct venus_inst *inst, u32 type)
 		if (IS_IRIS1(inst->core) &&
 		    inst->session_type == VIDC_SESSION_TYPE_ENC)
 			dev_info(dev,
-				 "venus-test13: internal type=%#x not requested by firmware, skip\n",
+				 "venus-sm8150: internal type=%#x not requested by firmware, skip\n",
 				 type);
 		return 0;
 	}
@@ -254,7 +254,7 @@ static int intbufs_set_buffer(struct venus_inst *inst, u32 type)
 		if (IS_IRIS1(inst->core) &&
 		    inst->session_type == VIDC_SESSION_TYPE_ENC)
 			dev_info(dev,
-				 "venus-test13: internal type=%#x has zero size, skip\n",
+				 "venus-sm8150: internal type=%#x has zero size, skip\n",
 				 type);
 		return 0;
 	}
@@ -262,7 +262,7 @@ static int intbufs_set_buffer(struct venus_inst *inst, u32 type)
 	if (IS_IRIS1(inst->core) &&
 	    inst->session_type == VIDC_SESSION_TYPE_ENC)
 		dev_info(dev,
-			 "venus-test13: internal req type=%#x size=%u count=%u align=%u\n",
+			 "venus-sm8150: internal req type=%#x size=%u count=%u align=%u\n",
 			 type, bufreq.size, bufreq.count_actual,
 			 bufreq.alignment);
 
@@ -311,7 +311,7 @@ static int intbufs_set_buffer(struct venus_inst *inst, u32 type)
 		if (IS_IRIS1(inst->core) &&
 		    inst->session_type == VIDC_SESSION_TYPE_ENC)
 			dev_info(dev,
-				 "venus-test13: SET_BUFFERS begin type=%#x index=%u req=%u size=%zu dma=%pad\n",
+				 "venus-sm8150: SET_BUFFERS begin type=%#x index=%u req=%u size=%zu dma=%pad\n",
 				 type, i, bufreq.size, buf->size, &buf->da);
 		ret = hfi_session_set_buffers(inst, &bd);
 		if (ret) {
@@ -321,7 +321,7 @@ static int intbufs_set_buffer(struct venus_inst *inst, u32 type)
 		if (IS_IRIS1(inst->core) &&
 		    inst->session_type == VIDC_SESSION_TYPE_ENC)
 			dev_info(dev,
-				 "venus-test13: SET_BUFFERS queued type=%#x index=%u\n",
+				 "venus-sm8150: SET_BUFFERS queued type=%#x index=%u\n",
 				 type, i);
 
 		list_add_tail(&buf->list, &inst->internalbufs);
@@ -353,7 +353,7 @@ static int intbufs_unset_buffers(struct venus_inst *inst)
 		if (IS_IRIS1(inst->core) &&
 		    inst->session_type == VIDC_SESSION_TYPE_ENC)
 			dev_info(inst->core->dev,
-				 "venus-test13: RELEASE_BUFFERS begin type=%#x size=%u\n",
+				 "venus-sm8150: RELEASE_BUFFERS begin type=%#x size=%u\n",
 				 buf->type, buf->size);
 		ret = hfi_session_unset_buffers(inst, &bd);
 		if (ret && !first_err)
@@ -361,7 +361,7 @@ static int intbufs_unset_buffers(struct venus_inst *inst)
 		if (IS_IRIS1(inst->core) &&
 		    inst->session_type == VIDC_SESSION_TYPE_ENC)
 			dev_info(inst->core->dev,
-				 "venus-test13: RELEASE_BUFFERS done type=%#x ret=%d\n",
+				 "venus-sm8150: RELEASE_BUFFERS done type=%#x ret=%d\n",
 				 buf->type, ret);
 
 		list_del_init(&buf->list);
@@ -418,7 +418,7 @@ int venus_helper_intbufs_alloc(struct venus_inst *inst)
 		if (IS_IRIS1(inst->core) &&
 		    inst->session_type == VIDC_SESSION_TYPE_ENC)
 			dev_info(inst->core->dev,
-				 "venus-test13: allocate internal step=%zu type=%#x\n",
+				 "venus-sm8150: allocate internal step=%zu type=%#x\n",
 				 i + 1, intbuf[i]);
 		ret = intbufs_set_buffer(inst, intbuf[i]);
 		if (ret)
@@ -651,7 +651,7 @@ session_process_buf(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 	if (IS_IRIS1(inst->core) &&
 	    inst->session_type == VIDC_SESSION_TYPE_ENC)
 		dev_info(inst->core->dev,
-			 "venus-migrate: queue %s tag=%u dma=%#x alloc=%u filled=%u offset=%u bidirectional=%u\n",
+			 "venus-sm8150: queue %s tag=%u dma=%#x alloc=%u filled=%u offset=%u bidirectional=%u\n",
 			 fdata.buffer_type == HFI_BUFFER_INPUT ? "ETB" : "FTB",
 			 fdata.clnt_data, fdata.device_addr, fdata.alloc_len,
 			 fdata.filled_len, fdata.offset,
@@ -661,7 +661,7 @@ session_process_buf(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 	if (IS_IRIS1(inst->core) &&
 	    inst->session_type == VIDC_SESSION_TYPE_ENC)
 		dev_info(inst->core->dev,
-			 "venus-test14: queued %s tag=%u ret=%d\n",
+			 "venus-sm8150: queued %s tag=%u ret=%d\n",
 			 fdata.buffer_type == HFI_BUFFER_INPUT ? "ETB" : "FTB",
 			 fdata.clnt_data, ret);
 
@@ -888,7 +888,7 @@ int venus_helper_cache_bufreqs(struct venus_inst *inst)
 		    (count_actual && count_min && count_actual < count_min) ||
 		    (req->alignment && !is_power_of_2(req->alignment))) {
 			dev_err(inst->core->dev,
-				"venus-test10: invalid encoder bufreq type=%#x actual=%u min=%u host=%u align=%u\n",
+				"venus-sm8150: invalid encoder bufreq type=%#x actual=%u min=%u host=%u align=%u\n",
 				req->type, count_actual, count_min,
 				count_min_host, req->alignment);
 			return -EINVAL;
@@ -906,7 +906,7 @@ int venus_helper_cache_bufreqs(struct venus_inst *inst)
 		}
 
 		dev_info(inst->core->dev,
-			 "venus-test10: firmware bufreq type=%#x size=%u actual=%u min=%u host=%u align=%u\n",
+			 "venus-sm8150: firmware bufreq type=%#x size=%u actual=%u min=%u host=%u align=%u\n",
 			 req->type, req->size, count_actual,
 			 count_min, count_min_host, req->alignment);
 	}
@@ -1583,7 +1583,7 @@ int venus_helper_set_work_mode(struct venus_inst *inst)
 
 	if (IS_IRIS1(inst->core) && inst->session_type == VIDC_SESSION_TYPE_ENC)
 		dev_info(inst->core->dev,
-			 "venus-test14: encoder work mode=%u rc_enable=%u bitrate_mode=%u\n",
+			 "venus-sm8150: encoder work mode=%u rc_enable=%u bitrate_mode=%u\n",
 			 mode, inst->controls.enc.rc_enable,
 			 inst->controls.enc.bitrate_mode);
 
@@ -1634,7 +1634,7 @@ int venus_helper_set_work_route(struct venus_inst *inst)
 		return ret;
 
 	inst->clk_data.work_route = wr.video_work_route;
-	dev_info(inst->core->dev, "venus-test7: session type=%u work route=%u\n",
+	dev_info(inst->core->dev, "venus-sm8150: session type=%u work route=%u\n",
 		 inst->session_type, wr.video_work_route);
 
 	return 0;
@@ -1706,7 +1706,7 @@ int venus_helper_set_input_format_constraints(struct venus_inst *inst, u32 pixfm
 	ret = venus_helper_set_format_constraints_for_type(inst, HFI_BUFFER_INPUT, 256);
 	if (!ret)
 		dev_info(inst->core->dev,
-			 "venus-migrate: encoder P010 constraints type=%#x stride=256 heights=32/16\n",
+			 "venus-sm8150: encoder P010 constraints type=%#x stride=256 heights=32/16\n",
 			 HFI_BUFFER_INPUT);
 
 	return ret;
@@ -1737,7 +1737,7 @@ int venus_helper_set_num_bufs(struct venus_inst *inst, unsigned int input_bufs,
 	}
 	if (iris1_encoder) {
 		dev_info(inst->core->dev,
-			 "venus-test13: input buffers actual=%u host-min=%u source=%s\n",
+			 "venus-sm8150: input buffers actual=%u host-min=%u source=%s\n",
 			 buf_count.count_actual, buf_count.count_min_host,
 			 inst->bufreq_cache_valid ? "firmware" : "initial");
 	}
@@ -1758,7 +1758,7 @@ int venus_helper_set_num_bufs(struct venus_inst *inst, unsigned int input_bufs,
 	}
 	if (iris1_encoder) {
 		dev_info(inst->core->dev,
-			 "venus-test13: output buffers actual=%u host-min=%u source=%s\n",
+			 "venus-sm8150: output buffers actual=%u host-min=%u source=%s\n",
 			 buf_count.count_actual, buf_count.count_min_host,
 			 inst->bufreq_cache_valid ? "firmware" : "initial");
 	}
@@ -2172,7 +2172,7 @@ int venus_helper_vb2_start_streaming(struct venus_inst *inst)
 	int ret;
 
 	if (IS_IRIS1(inst->core))
-		dev_info(inst->core->dev, "venus-test7: stream prepare begin type=%u\n",
+		dev_info(inst->core->dev, "venus-sm8150: stream prepare begin type=%u\n",
 			 inst->session_type);
 
 	ret = venus_helper_intbufs_alloc(inst);
@@ -2191,13 +2191,13 @@ int venus_helper_vb2_start_streaming(struct venus_inst *inst)
 	if (ret)
 		goto err_unreg_bufs;
 	if (IS_IRIS1(inst->core))
-		dev_info(inst->core->dev, "venus-test7: LOAD_RESOURCES complete\n");
+		dev_info(inst->core->dev, "venus-sm8150: LOAD_RESOURCES complete\n");
 
 	ret = hfi_session_start(inst);
 	if (ret)
 		goto err_unload_res;
 	if (IS_IRIS1(inst->core))
-		dev_info(inst->core->dev, "venus-test7: START complete\n");
+		dev_info(inst->core->dev, "venus-sm8150: START complete\n");
 
 	return 0;
 
diff --git a/drivers/media/platform/qcom/venus/hfi.c b/drivers/media/platform/qcom/venus/hfi.c
index 72ac4b4c29b2..b554f14e5c88 100644
--- a/drivers/media/platform/qcom/venus/hfi.c
+++ b/drivers/media/platform/qcom/venus/hfi.c
@@ -218,7 +218,7 @@ int hfi_session_init(struct venus_inst *inst, u32 pixfmt)
 
 	inst->state = INST_INIT;
 	if (IS_IRIS1(core))
-		dev_info(core->dev, "venus-test7: session_init OK type=%u codec=%#x\n",
+		dev_info(core->dev, "venus-sm8150: session_init OK type=%u codec=%#x\n",
 			 inst->session_type, inst->hfi_codec);
 
 	return 0;
@@ -506,7 +506,7 @@ int hfi_session_get_property(struct venus_inst *inst, u32 ptype,
 	reinit_completion(&inst->done);
 
 	if (IS_IRIS1(core))
-		dev_info(core->dev, "venus-test7: get_property type=%#x session_type=%u\n",
+		dev_info(core->dev, "venus-sm8150: get_property type=%#x session_type=%u\n",
 			 ptype, inst->session_type);
 
 	ret = ops->session_get_property(inst, ptype);
diff --git a/drivers/media/platform/qcom/venus/hfi_msgs.c b/drivers/media/platform/qcom/venus/hfi_msgs.c
index 437a6a75db2b..5b2195a71af7 100644
--- a/drivers/media/platform/qcom/venus/hfi_msgs.c
+++ b/drivers/media/platform/qcom/venus/hfi_msgs.c
@@ -307,7 +307,7 @@ sys_get_prop_image_version(struct venus_core *core,
 	img_ver[VER_STR_SZ] = '\0';
 
 	if (IS_IRIS1(core)) {
-		dev_info(dev, "venus-test7: raw firmware version: %.*s\n",
+		dev_info(dev, "venus-sm8150: raw firmware version: %.*s\n",
 			 VER_STR_SZ, img_ver);
 		ret = sscanf(img_ver, "14:VIDEO.IR.%u.%u-%u",
 			     &version.major, &version.minor, &version.rev);
diff --git a/drivers/media/platform/qcom/venus/hfi_venus.c b/drivers/media/platform/qcom/venus/hfi_venus.c
index 916b85119fc8..75c6aa14118b 100644
--- a/drivers/media/platform/qcom/venus/hfi_venus.c
+++ b/drivers/media/platform/qcom/venus/hfi_venus.c
@@ -206,7 +206,7 @@ static void venus_trace_packet(struct venus_hfi_device *hdev, const char *direct
 		property = ((const struct hfi_msg_session_property_info_pkt *)pkt)->property;
 
 	dev_info(hdev->core->dev,
-		"venus-test7: %s type=%#x(%s) property=%#x bytes=%u cmd=%lld msg=%lld irq=%lld\n",
+		"venus-sm8150: %s type=%#x(%s) property=%#x bytes=%u cmd=%lld msg=%lld irq=%lld\n",
 		direction, pkt->pkt_type, venus_packet_name(pkt->pkt_type), property,
 		pkt->size, atomic64_read(&hdev->cmd_count), atomic64_read(&hdev->msg_count),
 		atomic64_read(&hdev->irq_count));
@@ -261,7 +261,7 @@ static void venus_peek_debug_queue(struct venus_hfi_device *hdev)
 			u32 len = min_t(u32, pkt->msg_size,
 					copied * sizeof(u32) - sizeof(*pkt));
 
-			dev_err(hdev->core->dev, "venus-test7: pending FW debug: %.*s\n",
+			dev_err(hdev->core->dev, "venus-sm8150: pending FW debug: %.*s\n",
 				len, pkt->msg_data);
 		}
 		rd = (rd + words) % size;
@@ -285,12 +285,12 @@ void venus_hfi_dump_state(struct venus_core *core, const char *where, int error)
 	 */
 	mutex_lock(&hdev->lock);
 	dev_err(core->dev,
-		"venus-test7: %s: ret=%d state=%u powered=%u suspended=%u last_cmd=%#x irq=%#x\n",
+		"venus-sm8150: %s: ret=%d state=%u powered=%u suspended=%u last_cmd=%#x irq=%#x\n",
 		where, error, hdev->state, READ_ONCE(hdev->power_enabled),
 		READ_ONCE(hdev->suspended), hdev->last_packet_type,
 		READ_ONCE(hdev->irq_status));
 	dev_err(core->dev,
-		"venus-test7: totals cmd=%lld msg=%lld irq=%lld domains=%#x clocks=%#x hw=%#x freq=%lu\n",
+		"venus-sm8150: totals cmd=%lld msg=%lld irq=%lld domains=%#x clocks=%#x hw=%#x freq=%lu\n",
 		atomic64_read(&hdev->cmd_count), atomic64_read(&hdev->msg_count),
 		atomic64_read(&hdev->irq_count), READ_ONCE(core->iris1_pd_mask),
 		READ_ONCE(core->iris1_clk_mask), READ_ONCE(core->iris1_hw_mask),
@@ -303,7 +303,7 @@ void venus_hfi_dump_state(struct venus_core *core, const char *where, int error)
 			continue;
 
 		dev_err(core->dev,
-			"venus-test7: q%u: rd=%u wr=%u size=%u rx_req=%u tx_req=%u dropped=%u\n",
+			"venus-sm8150: q%u: rd=%u wr=%u size=%u rx_req=%u tx_req=%u dropped=%u\n",
 			i, READ_ONCE(qhdr->read_idx), READ_ONCE(qhdr->write_idx),
 			READ_ONCE(qhdr->q_size), READ_ONCE(qhdr->rx_req),
 			READ_ONCE(qhdr->tx_req), READ_ONCE(qhdr->pkt_drop_cnt));
@@ -670,7 +670,7 @@ static int venus_hfi_core_set_syscache(struct venus_core *core)
 	ret = venus_iface_cmdq_write(hdev, pkt, false);
 	if (!ret)
 		dev_info(core->dev,
-			 "venus-test9: supplied %zu LLCC slices to firmware\n",
+			 "venus-sm8150: supplied %zu LLCC slices to firmware\n",
 			 ARRAY_SIZE(entries));
 
 	return ret;
@@ -937,7 +937,7 @@ static int venus_iface_msgq_read_nolock(struct venus_hfi_device *hdev,
 	if (ret) {
 		if (IS_IRIS1(hdev->core) && ret != -ENODATA)
 			dev_err_ratelimited(hdev->core->dev,
-					    "venus-test7: invalid response queue: %d\n", ret);
+					    "venus-sm8150: invalid response queue: %d\n", ret);
 		return ret;
 	}
 	if (IS_IRIS1(hdev->core)) {
@@ -1237,7 +1237,7 @@ static void venus_flush_debug_queue(struct venus_hfi_device *hdev)
 				len = min_t(unsigned int, pkt->msg_size,
 					    pkt->hdr.size - sizeof(*pkt));
 				len = min(len, 512U);
-				dev_info_ratelimited(dev, "venus-test7: FW: %.*s\n",
+				dev_info_ratelimited(dev, "venus-sm8150: FW: %.*s\n",
 						     (int)len, pkt->msg_data);
 			} else {
 				dev_dbg(dev, VDBGFW "%s", pkt->msg_data);
@@ -1740,7 +1740,7 @@ static int venus_resume(struct venus_core *core)
 	mutex_unlock(&hdev->lock);
 
 	if (IS_IRIS1(core) && READ_ONCE(venus_iris1_debug))
-		dev_info_ratelimited(core->dev, "venus-test7: HFI resume ret=%d\n", ret);
+		dev_info_ratelimited(core->dev, "venus-sm8150: HFI resume ret=%d\n", ret);
 	if (ret)
 		venus_hfi_dump_state(core, "HFI resume", ret);
 
@@ -1924,7 +1924,7 @@ static int venus_suspend_3xx(struct venus_core *core)
 	mutex_unlock(&hdev->lock);
 
 	if (IS_IRIS1(core) && READ_ONCE(venus_iris1_debug))
-		dev_info_ratelimited(dev, "venus-test7: HFI suspend complete\n");
+		dev_info_ratelimited(dev, "venus-sm8150: HFI suspend complete\n");
 
 	return 0;
 }
diff --git a/drivers/media/platform/qcom/venus/pm_helpers.c b/drivers/media/platform/qcom/venus/pm_helpers.c
index debdc27737f3..0eb0f2d6e695 100644
--- a/drivers/media/platform/qcom/venus/pm_helpers.c
+++ b/drivers/media/platform/qcom/venus/pm_helpers.c
@@ -1593,7 +1593,7 @@ static int core_get_iris1(struct venus_core *core)
 	}
 
 	dev_info(core->dev,
-		 "venus-test9: found VIDSC0 id=%d size=%zu KiB, VIDSC1 id=%d size=%zu KiB\n",
+		 "venus-sm8150: found VIDSC0 id=%d size=%zu KiB, VIDSC1 id=%d size=%zu KiB\n",
 		 llcc_get_slice_id(core->iris1_llcc[0]),
 		 llcc_get_slice_size(core->iris1_llcc[0]),
 		 llcc_get_slice_id(core->iris1_llcc[1]),
@@ -1789,7 +1789,7 @@ static int core_power_iris1(struct venus_core *core, int on)
 	if (ret)
 		goto err;
 
-	dev_info_once(dev, "venus-test7: IRIS1 resources ready at %lu Hz (MVSC, MVS0, CVP)\n",
+	dev_info_once(dev, "venus-sm8150: IRIS1 resources ready at %lu Hz (MVSC, MVS0, CVP)\n",
 		      clk_get_rate(core->clks[0]));
 	return 0;
 
@@ -1965,7 +1965,7 @@ static int load_scale_v4(struct venus_inst *inst)
 			freq = max_freq;
 		if (!READ_ONCE(inst->iris1_ebd_count))
 			dev_info(dev,
-				 "venus-test7: first-input clock=%lu Hz route=%u payload=%lu\n",
+				 "venus-sm8150: first-input clock=%lu Hz route=%u payload=%lu\n",
 				 freq, inst->clk_data.work_route, filled_len);
 	}
 	inst->clk_data.freq = freq;
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index e26174f34d0a..af8f9a650142 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -411,7 +411,7 @@ static int vdec_try_fmt(struct file *file, void *fh, struct v4l2_format *f)
 	    f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
 	    inst->bit_depth == VIDC_BITDEPTH_10)
 		dev_info(inst->core->dev_dec,
-			 "venus-migrate: TRY_FMT capture fmt=%#x %ux%u stride=%u size=%u\n",
+			 "venus-sm8150: TRY_FMT capture fmt=%#x %ux%u stride=%u size=%u\n",
 			 pixmp->pixelformat, pixmp->width, pixmp->height,
 			 pixmp->plane_fmt[0].bytesperline,
 			 pixmp->plane_fmt[0].sizeimage);
@@ -492,7 +492,7 @@ static int vdec_g_fmt(struct file *file, void *fh, struct v4l2_format *f)
 	    f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
 	    inst->bit_depth == VIDC_BITDEPTH_10)
 		dev_info(inst->core->dev_dec,
-			 "venus-migrate: G_FMT capture fmt=%#x %ux%u stride=%u size=%u\n",
+			 "venus-sm8150: G_FMT capture fmt=%#x %ux%u stride=%u size=%u\n",
 			 pixmp->pixelformat, pixmp->width, pixmp->height,
 			 pixmp->plane_fmt[0].bytesperline,
 			 pixmp->plane_fmt[0].sizeimage);
@@ -578,7 +578,7 @@ static int vdec_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
 		if (IS_IRIS1(inst->core) &&
 		    inst->bit_depth == VIDC_BITDEPTH_10)
 			dev_info(inst->core->dev_dec,
-				 "venus-migrate: S_FMT capture requested=%#x selected=%#x stride=%u size=%u\n",
+				 "venus-sm8150: S_FMT capture requested=%#x selected=%#x stride=%u size=%u\n",
 				 orig_pixmp.pixelformat, pixmp->pixelformat,
 				 pixmp->plane_fmt[0].bytesperline,
 				 pixmp->plane_fmt[0].sizeimage);
@@ -993,7 +993,7 @@ static int vdec_output_conf(struct venus_inst *inst)
