From b882f1a6e282c7008fb051622510a30fd2b0ffe1 Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Fri, 11 Sep 2026 23:03:36 +0800
Subject: [PATCH] dt-bindings: media: describe SM8150 Venus resources

Document the separate controller, video and CVP resources used by the
IRIS1 driver, plus the MMCX operating-point dependency. The firmware
carveout remains memory-region index zero. A second reserved-memory
entry describes only the protected IOVA exclusion, not physical RAM.

Reference: Android Q sm8150-vidc.dtsi and the fixed Linux 7.1 generic
reserved-memory iommu-addresses mechanism. No Android ION or private
SMMU context-bank binding is introduced.

Allow a second memory-region in the common schema; existing single
region descriptions remain valid. Validate the new schema and the
Raphael DTB, including firmware index ordering and the IOVA interval.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 .../bindings/media/qcom,sm8150-venus.yaml     | 92 +++++++++++++++++++
 .../bindings/media/qcom,venus-common.yaml     |  3 +-
 2 files changed, 94 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/media/qcom,sm8150-venus.yaml

diff --git a/Documentation/devicetree/bindings/media/qcom,sm8150-venus.yaml b/Documentation/devicetree/bindings/media/qcom,sm8150-venus.yaml
new file mode 100644
index 000000000..d845ab183
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/qcom,sm8150-venus.yaml
@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/qcom,sm8150-venus.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM8150 Venus video encoder and decoder
+
+maintainers:
+  - snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
+
+description: |
+  SM8150 uses IRIS1/VPU5 with HFI4. MVS0 is the video codec island;
+  MVS1 is the CVP island and is not a second video codec core.
+
+allOf:
+  - $ref: qcom,venus-common.yaml#
+
+properties:
+  compatible:
+    const: qcom,sm8150-venus
+
+  clocks:
+    maxItems: 7
+
+  clock-names:
+    items:
+      - const: iface
+      - const: vcodec0_bus
+      - const: cvp_bus
+      - const: core
+      - const: vcodec0_core
+      - const: cvp_core
+      - const: bus
+
+  resets:
+    maxItems: 4
+
+  reset-names:
+    items:
+      - const: bus
+      - const: core
+      - const: vcodec0
+      - const: cvp
+
+  power-domains:
+    maxItems: 4
+
+  power-domain-names:
+    items:
+      - const: venus
+      - const: vcodec0
+      - const: cvp
+      - const: mmcx
+
+  iommus:
+    maxItems: 1
+
+  memory-region:
+    minItems: 2
+    maxItems: 2
+    description: Firmware carveout followed by the protected IOVA reservation.
+
+  memory-region-names:
+    items:
+      - const: firmware
+      - const: iova
+
+  interconnects:
+    maxItems: 2
+
+  interconnect-names:
+    items:
+      - const: video-mem
+      - const: cpu-cfg
+
+  operating-points-v2: true
+  opp-table:
+    type: object
+
+required:
+  - compatible
+  - resets
+  - reset-names
+  - power-domain-names
+  - iommus
+  - memory-region-names
+  - interconnects
+  - interconnect-names
+  - operating-points-v2
+
+unevaluatedProperties: false
diff --git a/Documentation/devicetree/bindings/media/qcom,venus-common.yaml b/Documentation/devicetree/bindings/media/qcom,venus-common.yaml
index 3153d91f9..b7e2c7e71 100644
--- a/Documentation/devicetree/bindings/media/qcom,venus-common.yaml
+++ b/Documentation/devicetree/bindings/media/qcom,venus-common.yaml
@@ -37,7 +37,8 @@ properties:
     maxItems: 20
 
   memory-region:
-    maxItems: 1
+    minItems: 1
+    maxItems: 2
 
   power-domains:
     minItems: 1
-- 
2.43.0

