+static u32 venc_pack_qp(u32 qp_i, u32 qp_p, u32 qp_b)
+{
+	return qp_i | (qp_p << 8) | (qp_b << 16);
+}
+
+static int venc_iris1_h264_sar(struct venus_inst *inst)
+{
+	static const struct hfi_aspect_ratio sar[] = {
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_1x1] = { 1, 1 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_12x11] = { 12, 11 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_10x11] = { 10, 11 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_16x11] = { 16, 11 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_40x33] = { 40, 33 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_24x11] = { 24, 11 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_20x11] = { 20, 11 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_32x11] = { 32, 11 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_80x33] = { 80, 33 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_18x11] = { 18, 11 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_15x11] = { 15, 11 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_64x33] = { 64, 33 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_160x99] = { 160, 99 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_4x3] = { 4, 3 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_3x2] = { 3, 2 },
+		[V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_2x1] = { 2, 1 },
+	};
+	struct venc_controls *ctr = &inst->controls.enc;
+	struct hfi_aspect_ratio aspect;
+
+	if (!IS_IRIS1(inst->core) || !ctr->h264_sar_enable)
+		return 0;
+
+	if (ctr->h264_sar_idc ==
+	    V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_EXTENDED) {
+		aspect.aspect_width = ctr->h264_sar_width;
+		aspect.aspect_height = ctr->h264_sar_height;
+	} else if (ctr->h264_sar_idc >
+		   V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_UNSPECIFIED &&
+		   ctr->h264_sar_idc < ARRAY_SIZE(sar)) {
+		aspect = sar[ctr->h264_sar_idc];
+	} else {
+		return 0;
+	}
+
+	return hfi_session_set_property(inst,
+					HFI_PROPERTY_PARAM_VENC_ASPECT_RATIO,
+					&aspect);
+}
+
+static int venc_iris1_internal_config(struct venus_inst *inst, u32 rate_control)
+{
+	struct venc_controls *ctr = &inst->controls.enc;
+	struct hfi_multi_slice_control multi = {
+		.multi_slice = HFI_MULTI_SLICE_OFF,
+	};
+	struct hfi_vbv_hdr_buf_size vbv;
+	struct hfi_enable low_latency = { .enable = 1 };
+	u32 mbs_per_frame, mbs_per_sec, max_avg_slice;
+	u32 ptype;
+	int ret;
+
+	if (!IS_IRIS1(inst->core))
+		return 0;
+	if (!inst->fps)
+		return -EINVAL;
+
+	mbs_per_frame = (ALIGN(inst->width, 16) / 16) *
+			(ALIGN(inst->height, 16) / 16);
+	mbs_per_sec = mbs_per_frame * inst->fps;
+
+	if ((rate_control == HFI_RATE_CONTROL_CBR_CFR ||
+	     rate_control == HFI_RATE_CONTROL_CBR_VFR) &&
+	    inst->hfi_codec != HFI_VIDEO_CODEC_VP8) {
+		vbv.vbv_hdr_buf_size = mbs_per_sec <= VENUS_IRIS1_CBR_MB_LIMIT ?
+					500 : 1000;
+		ptype = HFI_PROPERTY_CONFIG_VENC_VBV_HRD_BUF_SIZE;
+		ret = hfi_session_set_property(inst, ptype, &vbv);
+		if (ret)
+			return ret;
+
+		ptype = HFI_PROPERTY_PARAM_VENC_LOW_LATENCY_MODE;
+		ret = hfi_session_set_property(inst, ptype, &low_latency);
+		if (ret)
+			return ret;
+	}
+
+	if ((inst->hfi_codec == HFI_VIDEO_CODEC_H264 ||
+	     inst->hfi_codec == HFI_VIDEO_CODEC_HEVC) &&
+	    ctr->multi_slice_mode != V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_SINGLE) {
+		if (rate_control != HFI_RATE_CONTROL_OFF &&
+		    rate_control != HFI_RATE_CONTROL_CBR_CFR &&
+		    rate_control != HFI_RATE_CONTROL_CBR_VFR) {
+			multi.multi_slice = HFI_MULTI_SLICE_OFF;
+		} else if (ctr->multi_slice_mode ==
+			   V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_MAX_MB) {
+			if (inst->width <= 3840 && inst->height <= 3840 &&
+			    mbs_per_frame <= (3840 / 16) * (2160 / 16) &&
+			    inst->fps <= 60) {
+				multi.multi_slice = HFI_MULTI_SLICE_BY_MB_COUNT;
+				multi.slice_size = max(ctr->multi_slice_max_mb,
+						       mbs_per_frame / 10);
+			}
+		} else if (ctr->multi_slice_mode ==
+			   V4L2_MPEG_VIDEO_MULTI_SLICE_MODE_MAX_BYTES) {
+			if (inst->width <= 1920 && inst->height <= 1920 &&
+			    mbs_per_frame <= (1920 / 16) * (1088 / 16) &&
+			    inst->fps <= 30) {
+				max_avg_slice = ((ctr->bitrate / inst->fps) / 8) / 10;
+				multi.multi_slice = HFI_MULTI_SLICE_BY_BYTE_COUNT;
+				multi.slice_size = max(ctr->multi_slice_max_bytes,
+						       max_avg_slice);
+			}
+		}
+
+		ptype = HFI_PROPERTY_PARAM_VENC_MULTI_SLICE_CONTROL;
+		ret = hfi_session_set_property(inst, ptype, &multi);
+		if (ret)
+			return ret;
+	}
+
+	ptype = HFI_PROPERTY_CONFIG_VENC_BASELAYER_PRIORITYID;
+	return hfi_session_set_property(inst, ptype, &ctr->base_priority_id);
+}
+
 static int venc_set_properties(struct venus_inst *inst, bool set_work)
 {
 	struct venc_controls *ctr = &inst->controls.enc;
@@ -803,7 +928,7 @@ static int venc_set_properties(struct venus_inst *inst, bool set_work)
