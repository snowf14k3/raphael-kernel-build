 #define NUM_B_FRAMES_MAX	4
 #define VENUS_IRIS1_AUTO_QP	127
+#define VENUS_IRIS1_CBR_MB_LIMIT \
+	(((1280 + 15) / 16) * ((720 + 15) / 16) * 30)
 
 static bool venus_iris1_encoder_enable;
 module_param_named(iris1_encoder, venus_iris1_encoder_enable, bool, 0644);
@@ -794,6 +796,129 @@ static void venc_pm_touch(struct venus_inst *inst)
