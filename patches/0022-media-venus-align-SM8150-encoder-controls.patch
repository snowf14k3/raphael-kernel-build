 	struct hfi_enable en;
 	struct hfi_ltr_mode ltr_mode;
@@ -879,6 +1004,10 @@ static int venc_set_properties(struct venus_inst *inst, bool set_work)
 		if (ret)
 			return ret;
 
+		ret = venc_iris1_h264_sar(inst);
+		if (ret)
+			return ret;
+
 		if (ctr->layer_bitrate) {
 			unsigned int i;
 
@@ -1104,18 +1233,42 @@ static int venc_set_properties(struct venus_inst *inst, bool set_work)
 		ptype = HFI_PROPERTY_PARAM_VENC_SESSION_QP_RANGE_V2;
 
 		if (IS_IRIS1(inst->core) && !ctr->rc_enable) {
-			quant_range_v2.min_qp.qp_packed = VENUS_IRIS1_AUTO_QP;
-			quant_range_v2.max_qp.qp_packed = VENUS_IRIS1_AUTO_QP;
+			quant_range_v2.min_qp.qp_packed =
+				venc_pack_qp(VENUS_IRIS1_AUTO_QP,
+					     VENUS_IRIS1_AUTO_QP,
+					     VENUS_IRIS1_AUTO_QP);
+			quant_range_v2.max_qp.qp_packed =
+				quant_range_v2.min_qp.qp_packed;
 		} else if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_HEVC) {
-			quant_range_v2.min_qp.qp_packed = ctr->hevc_min_qp;
-			quant_range_v2.max_qp.qp_packed = ctr->hevc_max_qp;
+			quant_range_v2.min_qp.qp_packed =
+				venc_pack_qp(ctr->hevc_i_min_qp,
+					     ctr->hevc_p_min_qp,
+					     ctr->hevc_b_min_qp);
+			quant_range_v2.max_qp.qp_packed =
+				venc_pack_qp(ctr->hevc_i_max_qp,
+					     ctr->hevc_p_max_qp,
+					     ctr->hevc_b_max_qp);
 		} else if (inst->fmt_cap->pixfmt == V4L2_PIX_FMT_VP8) {
-			quant_range_v2.min_qp.qp_packed = ctr->vp8_min_qp;
-			quant_range_v2.max_qp.qp_packed = ctr->vp8_max_qp;
+			quant_range_v2.min_qp.qp_packed =
+				venc_pack_qp(ctr->vp8_min_qp, ctr->vp8_min_qp,
+					     ctr->vp8_min_qp);
+			quant_range_v2.max_qp.qp_packed =
+				venc_pack_qp(ctr->vp8_max_qp, ctr->vp8_max_qp,
+					     ctr->vp8_max_qp);
 		} else {
-			quant_range_v2.min_qp.qp_packed = ctr->h264_min_qp;
-			quant_range_v2.max_qp.qp_packed = ctr->h264_max_qp;
+			quant_range_v2.min_qp.qp_packed =
+				venc_pack_qp(ctr->h264_i_min_qp,
+					     ctr->h264_p_min_qp,
+					     ctr->h264_b_min_qp);
