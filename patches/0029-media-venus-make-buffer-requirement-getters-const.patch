From 90fdd58f0f51569a8fb7a8f29719ea1c422088dc Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Wed, 9 Sep 2026 20:03:42 +0800
Subject: [PATCH] media: venus: make buffer requirement getters const

The three hfi_bufreq_get_* helpers only read their requirement
argument. Mark it const so validation helpers can pass const requirements
without discarding qualifiers under Clang -Werror.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 drivers/media/platform/qcom/venus/hfi_helper.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/hfi_helper.h b/drivers/media/platform/qcom/venus/hfi_helper.h
index 0fbd68de0087..276cd9fa3d93 100644
--- a/drivers/media/platform/qcom/venus/hfi_helper.h
+++ b/drivers/media/platform/qcom/venus/hfi_helper.h
@@ -1214,7 +1214,7 @@ struct hfi_buffer_requirements {
 };
 
 /* On HFI 4XX, some of the struct members have been swapped. */
-static inline u32 hfi_bufreq_get_hold_count(struct hfi_buffer_requirements *req,
+static inline u32 hfi_bufreq_get_hold_count(const struct hfi_buffer_requirements *req,
 					    u32 ver)
 {
 	if (ver == HFI_VERSION_4XX)
@@ -1223,7 +1223,7 @@ static inline u32 hfi_bufreq_get_hold_count(struct hfi_buffer_requirements *req,
 	return req->hold_count;
 };
 
-static inline u32 hfi_bufreq_get_count_min(struct hfi_buffer_requirements *req,
+static inline u32 hfi_bufreq_get_count_min(const struct hfi_buffer_requirements *req,
 					   u32 ver)
 {
 	if (ver == HFI_VERSION_4XX)
@@ -1232,7 +1232,7 @@ static inline u32 hfi_bufreq_get_count_min(struct hfi_buffer_requirements *req,
 	return req->count_min;
 };
 
-static inline u32 hfi_bufreq_get_count_min_host(struct hfi_buffer_requirements *req,
+static inline u32 hfi_bufreq_get_count_min_host(const struct hfi_buffer_requirements *req,
 						u32 ver)
 {
 	if (ver == HFI_VERSION_4XX)
-- 
2.44.0.windows.1

