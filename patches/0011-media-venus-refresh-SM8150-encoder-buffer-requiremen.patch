From 86c0c3913d5d631e1bbb520f0b7773136be68e41 Mon Sep 17 00:00:00 2001
From: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
Date: Tue, 8 Sep 2026 16:54:24 +0800
Subject: [PATCH 11/12] media: venus: refresh SM8150 encoder buffer
 requirements

Keep the firmware's HFI minimum counts intact and refresh the complete
requirement table after SET_BUFFER_COUNT and SET_BUFFER_SIZE. This makes
the subsequent scratch and persistent allocations use the firmware's
final negotiated sizes instead of the stale pre-negotiation snapshot.

Signed-off-by: snowf14k3 <60956553+snowf14k3@users.noreply.github.com>
---
 drivers/media/platform/qcom/venus/helpers.c | 11 --------
 drivers/media/platform/qcom/venus/venc.c    | 30 ++++++++++++++++-----
 2 files changed, 24 insertions(+), 17 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
index 52992204c27e..f257008386ab 100644
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -767,21 +767,10 @@ int venus_helper_cache_bufreqs(struct venus_inst *inst)
 		if (req->type == HFI_BUFFER_INPUT) {
 			if (!req->size)
 				return -EINVAL;
-			/* Downstream keeps driver IO counts and imports size/alignment. */
-			req->count_actual = inst->num_input_bufs;
-			hfi_bufreq_set_count_min(req, ver,
-						 VENUS_IRIS1_ENC_MIN_BUFFERS);
-			hfi_bufreq_set_count_min_host(req, ver,
-						      VENUS_IRIS1_ENC_MIN_BUFFERS);
 			have_input = true;
 		} else if (req->type == HFI_BUFFER_OUTPUT) {
 			if (!req->size)
 				return -EINVAL;
-			req->count_actual = inst->num_output_bufs;
-			hfi_bufreq_set_count_min(req, ver,
-						 VENUS_IRIS1_ENC_MIN_BUFFERS);
-			hfi_bufreq_set_count_min_host(req, ver,
-						      VENUS_IRIS1_ENC_MIN_BUFFERS);
 			have_output = true;
 		}
 
diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index 4a7c3f064e89..d92ce9c058f4 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -1417,26 +1417,44 @@ static int venc_start_streaming(struct vb2_queue *q, unsigned int count)
 		goto error;
 
 	if (IS_IRIS1(inst->core)) {
-		/* Match downstream: GET once after route/mode/core selection. */
+		/*
+		 * Read the firmware minima before changing the negotiated counts.
+		 * Keep the table untouched: the HFI minima are not the same thing as
+		 * the V4L2 queue's minimum number of buffers.
+		 */
 		ret = venus_helper_cache_bufreqs(inst);
 		if (ret)
 			goto error;
+	}
 
+	ret = venus_helper_set_num_bufs(inst, inst->num_input_bufs,
+					inst->num_output_bufs, 0);
+	if (ret)
+		goto error;
+
+	if (IS_IRIS1(inst->core)) {
 		ret = venus_helper_set_bufsize(inst, inst->output_buf_size,
 					       HFI_BUFFER_OUTPUT);
 		if (ret)
 			goto error;
+
+		/*
+		 * SET_BUFFER_COUNT and SET_BUFFER_SIZE can change scratch and
+		 * persistent requirements.  The internal-buffer allocator must only
+		 * consume a fresh, coherent table, just like the downstream driver.
+		 */
+		ret = venus_helper_cache_bufreqs(inst);
+		if (ret)
+			goto error;
+
+		dev_info(inst->core->dev,
+			 "venus-test12: final encoder buffer requirements cached\n");
 	}
 
 	ret = venc_verify_conf(inst);
 	if (ret)
 		goto error;
 
-	ret = venus_helper_set_num_bufs(inst, inst->num_input_bufs,
-					inst->num_output_bufs, 0);
-	if (ret)
-		goto error;
-
 	ret = venc_iris1_dma_preflight(inst);
 	if (ret)
 		goto error;
-- 
